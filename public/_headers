# Cloudflare (Workers static assets / Pages) cache headers.
# /_astro/* filenames are content-hashed by the build — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-URL art. Not hashed, but changes are rare and a week's staleness is
# acceptable; the service worker refreshes opportunistically anyway.
/cards/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/tiles/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/textures/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=86400

# Never cache the service worker itself — updates must ship immediately.
/sw.js
  Cache-Control: no-cache
