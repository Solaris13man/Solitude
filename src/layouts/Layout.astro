---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Optional schema.org JSON-LD object(s) for this page. */
  schema?: object | object[];
  /** Error pages: excluded from the index, no canonical. */
  noindex?: boolean;
}

import { SITE_CONFIG } from '../lib/site-config';

const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const adsLive = SITE_CONFIG.ads.enabled && !!SITE_CONFIG.ads.adsenseClient;
---

<!doctype html>
<html lang="en" data-theme="auto" data-felt="green" data-cardback="classic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CardHearth" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#135c32" />
    {
      adsLive && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE_CONFIG.ads.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
    <script is:inline>
      // Apply persisted display settings before first paint to avoid flashes.
      try {
        var s = JSON.parse(localStorage.getItem('solitude.settings.v1') || '{}');
        var root = document.documentElement;
        if (s.theme) root.dataset.theme = s.theme;
        if (s.felt) root.dataset.felt = s.felt;
        if (s.cardBack) root.dataset.cardback = s.cardBack;
        if (s.animations === false) root.classList.add('no-animations');
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <div id="badge-toast" class="badge-toast" role="status" aria-live="polite" hidden></div>
    <script>
      import { initAnalytics } from '../lib/analytics';
      import { checkForNewBadges } from '../lib/achievements';
      import { initAccount, syncUp } from '../lib/account';
      import { initAdRefresh } from '../lib/ads';

      initAnalytics();
      initAdRefresh();
      void initAccount();

      // Celebrate badges the moment they unlock, after any game result.
      const queue: { icon: string; name: string }[] = [];
      let showing = false;
      function flush() {
        const toast = document.getElementById('badge-toast');
        if (!toast || showing) return;
        const next = queue.shift();
        if (!next) return;
        showing = true;
        toast.innerHTML = `<span class="badge-toast-icon">${next.icon}</span><span><b>Badge unlocked!</b><br>${next.name}</span>`;
        toast.hidden = false;
        toast.classList.add('show');
        window.setTimeout(() => {
          toast.classList.remove('show');
          window.setTimeout(() => {
            toast.hidden = true;
            showing = false;
            flush();
          }, 300);
        }, 3200);
      }
      window.addEventListener('cardhearth:result', () => {
        for (const b of checkForNewBadges()) queue.push({ icon: b.icon, name: b.name });
        flush();
        void syncUp();
      });

      // Register the service worker for installability + fast repeat loads.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
