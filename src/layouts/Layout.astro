---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Optional schema.org JSON-LD object(s) for this page. */
  schema?: object | object[];
  /** Error pages: excluded from the index, no canonical. */
  noindex?: boolean;
}

import { SITE_CONFIG } from '../lib/site-config';

const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Per-game share images live at /og/<slug>.png; fall back to the generic one.
const OG_SLUGS = new Set([
  'klondike', 'klondike-draw-3', 'spider', 'spider-2-suits', 'spider-4-suits',
  'freecell', 'pyramid', 'tripeaks', 'golf', 'yukon', 'scorpion',
  'forty-thieves', 'eight-off', 'hearts', 'spades', 'gin', 'euchre', 'sudoku', 'sudoku-easy',
  'sudoku-hard', 'sudoku-expert', 'mahjong', 'mahjong-turtle', 'minesweeper',
  'minesweeper-expert', '2048', 'daily-challenge',
]);
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');
// Guide pages reuse the relevant game's share image, matched by the slug's
// leading game name (e.g. /guides/hearts-rules -> /og/hearts.png). Anything
// without a clear game prefix falls back to the generic image.
const GUIDE_OG: [string, string][] = [
  ['gin-rummy', 'gin'], ['hearts', 'hearts'], ['spades', 'spades'], ['euchre', 'euchre'],
  ['freecell', 'freecell'], ['spider', 'spider'], ['klondike', 'klondike'], ['pyramid', 'pyramid'],
  ['tripeaks', 'tripeaks'], ['golf', 'golf'], ['sudoku', 'sudoku'], ['mahjong', 'mahjong'],
  ['minesweeper', 'minesweeper'], ['2048', '2048'], ['best-free-card', 'hearts'],
  ['rummy', 'gin'], ['yukon', 'yukon'], ['scorpion', 'scorpion'],
  ['forty-thieves', 'forty-thieves'], ['eight-off', 'eight-off'],
];
function ogPathFor(s: string): string {
  if (OG_SLUGS.has(s)) return `/og/${s}.png`;
  if (s.startsWith('guides/')) {
    const name = s.slice('guides/'.length);
    const hit = GUIDE_OG.find(([prefix]) => name.startsWith(prefix));
    if (hit) return `/og/${hit[1]}.png`;
  }
  return '/og.png';
}
const ogImage = new URL(ogPathFor(slug), Astro.site);
// Never serve ads on noindex/thin pages (404, account, profile) — keeps the
// AdSense unit off low-value screens, which matters under paid traffic.
const adsLive = SITE_CONFIG.ads.enabled && !!SITE_CONFIG.ads.adsenseClient && !noindex;
const ga = SITE_CONFIG.analytics;
const gaLive = ga.provider === 'ga' && !!ga.measurementId;
const ahrefsLive = !!ga.ahrefsKey;
---

<!doctype html>
<html lang="en" data-theme="auto" data-felt="green" data-cardback="classic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CardHearth" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#135c32" />
    {
      gaLive && (
        <>
          {/* Google tag (gtag.js) */}
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga.measurementId}`} />
          <script is:inline set:html={`window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '${ga.measurementId}');`} />
        </>
      )
    }
    {
      ahrefsLive && (
        /* Ahrefs Web Analytics */
        <script is:inline async src="https://analytics.ahrefs.com/analytics.js" data-key={ga.ahrefsKey} />
      )
    }
    {
      adsLive && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE_CONFIG.ads.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
    <script is:inline>
      // Apply persisted display settings before first paint to avoid flashes.
      try {
        var s = JSON.parse(localStorage.getItem('solitude.settings.v1') || '{}');
        var root = document.documentElement;
        if (s.theme) root.dataset.theme = s.theme;
        if (s.felt) root.dataset.felt = s.felt;
        if (s.tableSurface) root.dataset.surface = s.tableSurface;
        if (s.cardBack) root.dataset.cardback = s.cardBack;
        if (s.cardSet) root.dataset.cardset = s.cardSet;
        if (s.tileSet) root.dataset.tileset = s.tileSet;
        if (s.animations === false) root.classList.add('no-animations');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <div id="badge-toast" class="badge-toast" role="status" aria-live="polite" hidden></div>
    <script>
      import { initAnalytics, track } from '../lib/analytics';
      import { checkForNewBadges } from '../lib/achievements';
      import { initAccount, syncUp } from '../lib/account';
      import { initAdRefresh } from '../lib/ads';
      import { initDailyReminder } from '../lib/daily-reminder';
      import { syncDailySolvedCache } from '../lib/push';

      initAnalytics();
      initAdRefresh();
      void initAccount();
      initDailyReminder();
      void syncDailySolvedCache();

      // Celebrate badges the moment they unlock, after any game result.
      const queue: { icon: string; name: string }[] = [];
      let showing = false;
      function flush() {
        const toast = document.getElementById('badge-toast');
        if (!toast || showing) return;
        const next = queue.shift();
        if (!next) return;
        showing = true;
        toast.innerHTML = `<span class="badge-toast-icon">${next.icon}</span><span><b>Badge unlocked!</b><br>${next.name}</span>`;
        toast.hidden = false;
        toast.classList.add('show');
        window.setTimeout(() => {
          toast.classList.remove('show');
          window.setTimeout(() => {
            toast.hidden = true;
            showing = false;
            flush();
          }, 300);
        }, 3200);
      }
      window.addEventListener('cardhearth:result', () => {
        for (const b of checkForNewBadges()) {
          queue.push({ icon: b.icon, name: b.name });
          track('badge_unlocked', { badge_id: b.id, badge_name: b.name });
        }
        flush();
        void syncUp();
        void syncDailySolvedCache();
      });

      // Push display-preference changes (theme, cards, tiles, …) to the cloud
      // for signed-in players so they follow them across devices.
      window.addEventListener('cardhearth:settings', () => void syncUp());

      // Register the service worker for installability + fast repeat loads.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
