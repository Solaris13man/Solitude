---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Optional schema.org JSON-LD object(s) for this page. */
  schema?: object | object[];
  /** Error pages: excluded from the index, no canonical. */
  noindex?: boolean;
}

import { SITE_CONFIG } from '../lib/site-config';

const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Per-game share images live at /og/<slug>.png; fall back to the generic one.
const OG_SLUGS = new Set([
  'klondike', 'klondike-draw-3', 'spider', 'spider-2-suits', 'spider-4-suits',
  'freecell', 'pyramid', 'tripeaks', 'golf', 'yukon', 'scorpion',
  'forty-thieves', 'eight-off', 'hearts', 'spades', 'gin', 'euchre', 'sudoku', 'sudoku-easy',
  'sudoku-hard', 'sudoku-expert', 'mahjong', 'mahjong-turtle', 'minesweeper',
  'minesweeper-expert', '2048', 'daily-challenge',
]);
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');
// Guide pages reuse the relevant game's share image, matched by the slug's
// leading game name (e.g. /guides/hearts-rules -> /og/hearts.png). Anything
// without a clear game prefix falls back to the generic image.
const GUIDE_OG: [string, string][] = [
  ['gin-rummy', 'gin'], ['hearts', 'hearts'], ['spades', 'spades'], ['euchre', 'euchre'],
  ['freecell', 'freecell'], ['spider', 'spider'], ['klondike', 'klondike'], ['pyramid', 'pyramid'],
  ['tripeaks', 'tripeaks'], ['golf', 'golf'], ['sudoku', 'sudoku'], ['mahjong', 'mahjong'],
  ['minesweeper', 'minesweeper'], ['2048', '2048'], ['best-free-card', 'hearts'],
  ['rummy', 'gin'], ['yukon', 'yukon'], ['scorpion', 'scorpion'],
  ['forty-thieves', 'forty-thieves'], ['eight-off', 'eight-off'],
  ['how-to-win-klondike', 'klondike'], ['how-to-play-sudoku', 'sudoku'],
  ['how-to-play-minesweeper', 'minesweeper'], ['how-to-play-2048', '2048'],
  ['what-is-mahjong', 'mahjong'], ['solitaire-rules', 'klondike'],
  ['solitaire-glossary', 'klondike'], ['are-solitaire', 'klondike'],
  ['best-free-solitaire', 'klondike'],
];
function ogPathFor(s: string): string {
  if (OG_SLUGS.has(s)) return `/og/${s}.png`;
  if (s.startsWith('guides/')) {
    const name = s.slice('guides/'.length);
    const hit = GUIDE_OG.find(([prefix]) => name.startsWith(prefix));
    if (hit) return `/og/${hit[1]}.png`;
  }
  return '/og.png';
}
const ogImage = new URL(ogPathFor(slug), Astro.site);
// Guides are articles; everything else (games, hubs) is closest to "website".
const ogType = slug.startsWith('guides/') && slug !== 'guides' ? 'article' : 'website';
// Never serve ads on noindex/thin pages (404, account, profile) — keeps the
// AdSense unit off low-value screens, which matters under paid traffic.
// Ads are "live" only when a real unit can render — client id AND slot id.
// Without the slot, AdSlot renders nothing, so loading adsbygoogle.js
// would be pure dead weight on every page.
const adsLive =
  SITE_CONFIG.ads.enabled &&
  !!SITE_CONFIG.ads.adsenseClient &&
  !!SITE_CONFIG.ads.inContentSlot &&
  !noindex;
const ga = SITE_CONFIG.analytics;
const gaLive = ga.provider === 'ga' && !!ga.measurementId;
const ahrefsLive = !!ga.ahrefsKey;
---

<!doctype html>
<html lang="en" data-theme="auto" data-felt="green" data-cardback="classic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CardHearth" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#135c32" />
    {
      /* Warm up the DNS/TLS for the deferred third-party origins without
         forcing an early connection on the critical path. */
      (gaLive || ahrefsLive || adsLive) && (
        <>
          {gaLive && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}
          {ahrefsLive && <link rel="dns-prefetch" href="https://analytics.ahrefs.com" />}
          {adsLive && <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />}
        </>
      )
    }
    {
      gaLive && (
        /* GA queue stub stays in <head> so events are captured immediately;
           gtag.js itself is loaded later (see the deferred loader below). */
        <script is:inline set:html={`window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '${ga.measurementId}');`} />
      )
    }
    {
      (gaLive || ahrefsLive || adsLive) && (
        /* Keep GA, Ahrefs and AdSense off the critical render path: load them
           on the first user interaction or shortly after load, whichever comes
           first. This protects LCP/INP without losing analytics or ads. */
        <script
          is:inline
          define:vars={{
            gaId: gaLive ? ga.measurementId : '',
            ahrefsKey: ahrefsLive ? ga.ahrefsKey : '',
            adsClient: adsLive ? SITE_CONFIG.ads.adsenseClient : '',
          }}
          set:html={`(function(){var done=false;var evts=['pointerdown','keydown','touchstart','scroll'];var opts={once:true,passive:true,capture:true};
function add(src,attrs){var s=document.createElement('script');s.async=true;s.src=src;if(attrs)for(var k in attrs)s.setAttribute(k,attrs[k]);document.head.appendChild(s);}
function go(){if(done)return;done=true;evts.forEach(function(e){window.removeEventListener(e,go,opts);});
if(gaId)add('https://www.googletagmanager.com/gtag/js?id='+gaId);
if(ahrefsKey)add('https://analytics.ahrefs.com/analytics.js',{'data-key':ahrefsKey});
if(adsClient)add('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+adsClient,{crossorigin:'anonymous'});}
evts.forEach(function(e){window.addEventListener(e,go,opts);});
if(document.readyState==='complete')setTimeout(go,2500);else window.addEventListener('load',function(){setTimeout(go,2500);});})();`}
        />
      )
    }
    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
    <script is:inline>
      // Apply persisted display settings before first paint to avoid flashes.
      try {
        var s = JSON.parse(localStorage.getItem('solitude.settings.v1') || '{}');
        var root = document.documentElement;
        if (s.theme) root.dataset.theme = s.theme;
        if (s.felt) root.dataset.felt = s.felt;
        if (s.tableSurface) root.dataset.surface = s.tableSurface;
        if (s.cardBack) root.dataset.cardback = s.cardBack;
        if (s.cardSet) root.dataset.cardset = s.cardSet;
        if (s.tileSet) root.dataset.tileset = s.tileSet;
        if (s.animations === false) root.classList.add('no-animations');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <div id="badge-toast" class="badge-toast" role="status" aria-live="polite"></div>
    <script>
      import { initAnalytics, track } from '../lib/analytics';
      import { checkForNewBadges } from '../lib/achievements';
      import { initAccount, syncUp } from '../lib/account';
      import { initAdRefresh } from '../lib/ads';
      import { initDailyReminder } from '../lib/daily-reminder';
      import { syncDailySolvedCache } from '../lib/push';

      initAnalytics();
      initAdRefresh();
      void initAccount();
      initDailyReminder();
      void syncDailySolvedCache();

      // Celebrate badges the moment they unlock, after any game result.
      const queue: { icon: string; name: string }[] = [];
      let showing = false;
      function flush() {
        const toast = document.getElementById('badge-toast');
        if (!toast || showing) return;
        const next = queue.shift();
        if (!next) return;
        showing = true;
        toast.innerHTML = `<span class="badge-toast-icon">${next.icon}</span><span><b>Badge unlocked!</b><br>${next.name}</span>`;
        toast.classList.add('show');
        window.setTimeout(() => {
          toast.classList.remove('show');
          window.setTimeout(() => {
            toast.innerHTML = '';
            showing = false;
            flush();
          }, 300);
        }, 3200);
      }
      window.addEventListener('cardhearth:result', () => {
        for (const b of checkForNewBadges()) {
          queue.push({ icon: b.icon, name: b.name });
          track('badge_unlocked', { badge_id: b.id, badge_name: b.name });
        }
        flush();
        void syncUp();
        void syncDailySolvedCache();
      });

      // Push display-preference changes (theme, cards, tiles, …) to the cloud
      // for signed-in players so they follow them across devices.
      window.addEventListener('cardhearth:settings', () => void syncUp());

      // Register the service worker for installability + fast repeat loads.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
