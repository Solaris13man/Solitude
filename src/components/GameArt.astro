---
/**
 * Original SVG artwork for the game menu cards. Each scene is a stylized
 * depiction of the game it links to — drawn by hand for this project.
 */
interface Props {
  game: string;
}

const { game } = Astro.props;
---

{
  game === 'klondike' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Fanned playing cards" class="art">
      <g transform="translate(76 78) rotate(-16)">
        <rect x="-28" y="-39" width="56" height="78" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-20" y="-22" font-size="13" font-weight="700" fill="#c2273a">Q</text>
        <text x="0" y="12" font-size="30" text-anchor="middle" fill="#c2273a">♦</text>
      </g>
      <g transform="translate(120 68)">
        <rect x="-28" y="-39" width="56" height="78" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-20" y="-22" font-size="13" font-weight="700" fill="#1d2230">A</text>
        <text x="0" y="12" font-size="30" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
      <g transform="translate(164 78) rotate(16)">
        <rect x="-28" y="-39" width="56" height="78" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-20" y="-22" font-size="13" font-weight="700" fill="#c2273a">K</text>
        <text x="0" y="12" font-size="30" text-anchor="middle" fill="#c2273a">♥</text>
      </g>
    </svg>
  )
}
{
  game === 'spider' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A descending run of spades" class="art">
      <rect x="38" y="26" width="50" height="70" rx="6" fill="#8c1f26" stroke="#fff" stroke-opacity="0.5" />
      <rect x="34" y="30" width="50" height="70" rx="6" fill="#a32934" stroke="#fff" stroke-opacity="0.6" />
      <rect x="156" y="26" width="50" height="70" rx="6" fill="#8c1f26" stroke="#fff" stroke-opacity="0.5" />
      <rect x="152" y="30" width="50" height="70" rx="6" fill="#a32934" stroke="#fff" stroke-opacity="0.6" />
      <g>
        <rect x="93" y="8" width="54" height="76" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="100" y="24" font-size="12" font-weight="700" fill="#1d2230">K♠</text>
        <rect x="93" y="34" width="54" height="76" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="100" y="50" font-size="12" font-weight="700" fill="#1d2230">Q♠</text>
        <rect x="93" y="60" width="54" height="76" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="100" y="76" font-size="12" font-weight="700" fill="#1d2230">J♠</text>
        <text x="120" y="112" font-size="26" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
    </svg>
  )
}
{
  game === 'pyramid' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A pyramid of cards" class="art">
      {[
        [120, 16],
        [102, 44], [138, 44],
        [84, 72], [120, 72], [156, 72],
        [66, 100], [102, 100], [138, 100], [174, 100],
      ].map(([x, y], i) => (
        <rect x={x! - 15} y={y!} width="30" height="42" rx="4" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      ))}
      <text x="120" y="44" font-size="14" text-anchor="middle" fill="#1d2230">♠</text>
      <text x="66" y="128" font-size="11" text-anchor="middle" fill="#c2273a">6♥</text>
      <text x="174" y="128" font-size="11" text-anchor="middle" fill="#1d2230">7♣</text>
    </svg>
  )
}
{
  game === 'tripeaks' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Three peaks of cards" class="art">
      {[
        [60, 14], [120, 14], [180, 14],
        [46, 44], [74, 44], [106, 44], [134, 44], [166, 44], [194, 44],
        [32, 74], [60, 74], [88, 74], [116, 74], [144, 74], [172, 74], [200, 74],
      ].map(([x, y]) => (
        <rect x={x! - 13} y={y!} width="26" height="36" rx="3.5" fill={y! < 70 ? '#a32934' : '#fcfcf7'} stroke={y! < 70 ? '#ffffff' : '#1d2230'} stroke-opacity={y! < 70 ? '0.5' : '0.3'} />
      ))}
      <text x="60" y="98" font-size="11" text-anchor="middle" fill="#c2273a">9♦</text>
      <text x="116" y="98" font-size="11" text-anchor="middle" fill="#1d2230">8♠</text>
      <text x="172" y="98" font-size="11" text-anchor="middle" fill="#c2273a">7♥</text>
      <text x="120" y="128" font-size="13" text-anchor="middle" fill="#ffd95e">★ streak ★</text>
    </svg>
  )
}
{
  game === 'golf' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Golf solitaire columns" class="art">
      {[0, 1, 2, 3, 4].map((c) => (
        <g>
          <rect x={52 + c * 28} y="14" width="26" height="36" rx="3.5" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
          <rect x={52 + c * 28} y="32" width="26" height="36" rx="3.5" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
          <rect x={52 + c * 28} y="50" width="26" height="36" rx="3.5" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        </g>
      ))}
      <text x="65" y="76" font-size="11" text-anchor="middle" fill="#1d2230">4♣</text>
      <text x="93" y="76" font-size="11" text-anchor="middle" fill="#c2273a">6♦</text>
      <text x="121" y="76" font-size="11" text-anchor="middle" fill="#1d2230">5♠</text>
      <text x="149" y="76" font-size="11" text-anchor="middle" fill="#c2273a">7♥</text>
      <text x="177" y="76" font-size="11" text-anchor="middle" fill="#1d2230">3♠</text>
      <g transform="translate(120 112)">
        <rect x="-15" y="-21" width="30" height="42" rx="4" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.35" />
        <text x="0" y="6" font-size="14" text-anchor="middle" fill="#c2273a">5♥</text>
      </g>
    </svg>
  )
}
{
  game === 'yukon' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Overlapping columns of face-up cards" class="art">
      {[78, 138].map((x) =>
        [0, 1, 2, 3, 4].map((i) => (
          <rect x={x - 24} y={12 + i * 19} width="48" height="62" rx="5" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        ))
      )}
      <text x="60" y="120" font-size="12" font-weight="700" fill="#1d2230">10♠</text>
      <text x="120" y="120" font-size="12" font-weight="700" fill="#c2273a">9♥</text>
    </svg>
  )
}
{
  game === 'scorpion' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A same-suit run of spades" class="art">
      {[0, 1, 2, 3].map((i) => (
        <rect x="95" y={12 + i * 24} width="50" height="70" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      ))}
      <text x="102" y="30" font-size="12" font-weight="700" fill="#1d2230">K♠</text>
      <text x="102" y="54" font-size="12" font-weight="700" fill="#1d2230">Q♠</text>
      <text x="102" y="78" font-size="12" font-weight="700" fill="#1d2230">J♠</text>
      <text x="120" y="116" font-size="28" text-anchor="middle" fill="#1d2230">♠</text>
    </svg>
  )
}
{
  game === 'fortythieves' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Two-deck Forty Thieves" class="art">
      {[0, 1, 2].map((i) => (
        <rect x={30 + i * 3} y={16 + i * 3} width="42" height="60" rx="5" fill="#a32934" stroke="#fff" stroke-opacity="0.5" />
      ))}
      {[0, 1, 2, 3, 4].map((c) =>
        [0, 1].map((r) => (
          <rect x={92 + c * 28} y={20 + r * 22} width="26" height="36" rx="3.5" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        ))
      )}
      <text x="142" y="122" font-size="13" font-weight="800" text-anchor="middle" fill="#ffd95e">×2 decks</text>
    </svg>
  )
}
{
  game === 'eightoff' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Eight free cells and a card" class="art">
      <g fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="2">
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect x={14 + i * 27} y="14" width="22" height="32" rx="4" />
        ))}
      </g>
      <g transform="translate(120 92) rotate(-4)">
        <rect x="-24" y="-32" width="48" height="64" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-16" y="-14" font-size="12" font-weight="700" fill="#1d2230">8</text>
        <text x="0" y="12" font-size="24" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
    </svg>
  )
}
{
  game === 'gin' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A run and a set of cards" class="art">
      {[0, 1, 2].map((i) => (
        <g transform={`translate(${66 + i * 20} 40)`}>
          <rect x="-15" y="-22" width="30" height="44" rx="4" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
          <text x="0" y="6" font-size="14" text-anchor="middle" fill="#c2273a">{['3', '4', '5'][i]}</text>
          <text x="-9" y="-9" font-size="8" font-weight="700" fill="#c2273a">♥</text>
        </g>
      ))}
      {[0, 1, 2].map((i) => (
        <g transform={`translate(${120 + i * 20} 92)`}>
          <rect x="-15" y="-22" width="30" height="44" rx="4" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
          <text x="0" y="6" font-size="13" text-anchor="middle" fill="#1d2230">8</text>
          <text x="-9" y="-9" font-size="8" font-weight="700" fill="#1d2230">{['♠', '♣', '♠'][i]}</text>
        </g>
      ))}
      <text x="120" y="126" font-size="11" font-weight="800" text-anchor="middle" fill="#ffd95e">run + set</text>
    </svg>
  )
}
{
  game === 'spades' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A fan of spade cards with a bid" class="art">
      <g transform="translate(88 72) rotate(-15)">
        <rect x="-26" y="-37" width="52" height="74" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-19" font-size="12" font-weight="700" fill="#1d2230">A</text>
        <text x="0" y="12" font-size="28" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
      <g transform="translate(124 64)">
        <rect x="-26" y="-37" width="52" height="74" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-19" font-size="12" font-weight="700" fill="#1d2230">K</text>
        <text x="0" y="12" font-size="28" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
      <g transform="translate(160 72) rotate(15)">
        <rect x="-26" y="-37" width="52" height="74" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-19" font-size="12" font-weight="700" fill="#1d2230">Q</text>
        <text x="0" y="12" font-size="28" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
      <text x="120" y="126" font-size="12" font-weight="800" text-anchor="middle" fill="#ffd95e">bid · nil · 500</text>
    </svg>
  )
}
{
  game === 'hearts' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A trick of cards with the Queen of Spades" class="art">
      <g transform="translate(86 70) rotate(-14)">
        <rect x="-26" y="-37" width="52" height="74" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-19" font-size="12" font-weight="700" fill="#c2273a">A</text>
        <text x="0" y="12" font-size="28" text-anchor="middle" fill="#c2273a">♥</text>
      </g>
      <g transform="translate(122 64)">
        <rect x="-26" y="-37" width="52" height="74" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-19" font-size="12" font-weight="700" fill="#1d2230">Q</text>
        <text x="0" y="12" font-size="28" text-anchor="middle" fill="#1d2230">♠</text>
      </g>
      <g transform="translate(158 70) rotate(14)">
        <rect x="-26" y="-37" width="52" height="74" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-19" font-size="12" font-weight="700" fill="#c2273a">K</text>
        <text x="0" y="12" font-size="28" text-anchor="middle" fill="#c2273a">♥</text>
      </g>
    </svg>
  )
}
{
  game === 'mahjong' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Stacked mahjong tiles" class="art">
      {[
        [52, 52, 0], [86, 52, 0], [120, 52, 0], [154, 52, 0], [188, 52, 0],
        [69, 86, 0], [103, 86, 0], [137, 86, 0], [171, 86, 0],
        [95, 30, 1], [129, 30, 1],
      ].map(([x, y, top]) => (
        <g transform={`translate(${x} ${y})`}>
          <rect x="-14" y="-19" width="28" height="38" rx="3" fill={top ? '#fffef8' : '#efeadb'} stroke="#5a4b32" stroke-opacity="0.45" />
          <rect x="-12" y="17" width="28" height="3" rx="1.5" fill="#aa966e" />
        </g>
      ))}
      <text x="52" y="60" font-size="15" text-anchor="middle" fill="#c2273a">中</text>
      <text x="120" y="60" font-size="15" text-anchor="middle" fill="#2c5fa8">●</text>
      <text x="188" y="60" font-size="15" text-anchor="middle" fill="#2e7d32">❚</text>
      <text x="95" y="38" font-size="15" text-anchor="middle" fill="#1d2230">東</text>
      <text x="129" y="38" font-size="15" text-anchor="middle" fill="#c2563a">✿</text>
      <text x="103" y="94" font-size="15" text-anchor="middle" fill="#c2273a">万</text>
      <text x="171" y="94" font-size="15" text-anchor="middle" fill="#1d7a45">春</text>
    </svg>
  )
}
{
  game === 'sudoku' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A sudoku grid" class="art">
      <rect x="75" y="13" width="108" height="108" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      <g stroke="#1d2230" stroke-opacity="0.18">
        <path d="M87 13v108M99 13v108M123 13v108M135 13v108M159 13v108M171 13v108" />
        <path d="M75 25h108M75 37h108M75 61h108M75 73h108M75 97h108M75 109h108" />
      </g>
      <g stroke="#1d2230" stroke-opacity="0.55" stroke-width="2">
        <path d="M111 13v108M147 13v108M75 49h108M75 85h108" />
      </g>
      <g font-size="10" font-weight="700" fill="#1d2230">
        <text x="78.5" y="22.5">5</text>
        <text x="114.5" y="22.5">7</text>
        <text x="162.5" y="34.5">1</text>
        <text x="90.5" y="58.5">9</text>
        <text x="138.5" y="70.5">4</text>
        <text x="78.5" y="94.5">3</text>
        <text x="150.5" y="106.5">8</text>
      </g>
      <g font-size="10" font-weight="700" fill="#2c5fa8">
        <text x="126.5" y="46.5">2</text>
        <text x="102.5" y="82.5">6</text>
        <text x="174.5" y="118.5">5</text>
      </g>
      <rect x="123" y="37" width="12" height="12" fill="#ffd95e" fill-opacity="0.45" />
    </svg>
  )
}
{
  game === 'minesweeper' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A minesweeper board" class="art">
      <rect x="66" y="14" width="108" height="108" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      {[0, 1, 2, 3].map((r) =>
        [0, 1, 2, 3].map((c) => (
          <rect
            x={66 + c * 27}
            y={14 + r * 27}
            width="27"
            height="27"
            fill={(r + c) % 2 === 0 ? '#c9d3c9' : '#aab8ab'}
            stroke="#1d2230"
            stroke-opacity="0.2"
          />
        ))
      )}
      <rect x="66" y="68" width="54" height="54" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.2" />
      <text x="80" y="105" font-size="18" font-weight="800" fill="#2c5fa8">1</text>
      <text x="107" y="105" font-size="18" font-weight="800" fill="#2e7d32">2</text>
      <text x="133" y="51" font-size="18" text-anchor="middle" fill="#c2273a">⚑</text>
      <text x="160" y="105" font-size="18" text-anchor="middle" fill="#1d2230">✸</text>
    </svg>
  )
}
{
  game === '2048' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="2048 tiles" class="art">
      <rect x="62" y="11" width="116" height="116" rx="8" fill="#1d2230" fill-opacity="0.35" />
      {[
        [68, 17, '2', '#efe4ce', '#43320a'],
        [125, 17, '8', '#f2b179', '#ffffff'],
        [68, 74, '4', '#ece0c2', '#43320a'],
        [125, 74, '16', '#f59563', '#ffffff'],
      ].map(([x, y, label, bg, fg]) => (
        <g>
          <rect x={x} y={y} width="47" height="47" rx="5" fill={bg as string} />
          <text x={(x as number) + 23.5} y={(y as number) + 31} font-size="20" font-weight="800" text-anchor="middle" fill={fg as string}>{label}</text>
        </g>
      ))}
      <text x="198" y="75" font-size="22" text-anchor="middle" fill="#ffd95e">→</text>
      <text x="40" y="75" font-size="22" text-anchor="middle" fill="#ffd95e">←</text>
    </svg>
  )
}
{
  game === 'daily' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="A calendar page with a playing card" class="art">
      <rect x="60" y="22" width="92" height="92" rx="10" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      <rect x="60" y="22" width="92" height="26" rx="10" fill="#c2273a" />
      <rect x="60" y="38" width="92" height="10" fill="#c2273a" />
      <circle cx="82" cy="22" r="4" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      <circle cx="130" cy="22" r="4" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
      <text x="106" y="92" font-size="34" font-weight="700" text-anchor="middle" fill="#1d2230">13</text>
      <g transform="translate(170 78) rotate(12)">
        <rect x="-26" y="-36" width="52" height="72" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-18" font-size="12" font-weight="700" fill="#c2273a">A</text>
        <text x="0" y="10" font-size="26" text-anchor="middle" fill="#c2273a">♦</text>
      </g>
      <text x="44" y="40" font-size="16" fill="#ffd95e">★</text>
    </svg>
  )
}
{
  game === 'freecell' && (
    <svg viewBox="0 0 240 135" role="img" aria-label="Free cells and an ace" class="art">
      <g fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="2">
        <rect x="26" y="14" width="40" height="56" rx="5" />
        <rect x="76" y="14" width="40" height="56" rx="5" />
        <rect x="126" y="14" width="40" height="56" rx="5" />
        <rect x="176" y="14" width="40" height="56" rx="5" />
      </g>
      <g transform="translate(96 47) rotate(-6)">
        <rect x="-20" y="-28" width="40" height="56" rx="5" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="0" y="8" font-size="20" text-anchor="middle" fill="#1d2230">♣</text>
      </g>
      <g transform="translate(120 100) rotate(5)">
        <rect x="-26" y="-34" width="52" height="68" rx="6" fill="#fcfcf7" stroke="#1d2230" stroke-opacity="0.3" />
        <text x="-18" y="-18" font-size="12" font-weight="700" fill="#c2273a">A</text>
        <text x="0" y="10" font-size="26" text-anchor="middle" fill="#c2273a">♥</text>
      </g>
    </svg>
  )
}
