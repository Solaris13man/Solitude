---
import { SITE_CONFIG } from '../lib/site-config';

interface Props {
  /** Slot label, used as the DOM data-slot for the refresh helper. */
  slot?: string;
}

const { slot = 'in-content' } = Astro.props;
const { ads, showAdPlaceholders } = SITE_CONFIG;
const live = ads.enabled && !!ads.adsenseClient && !!ads.inContentSlot;
// Render nothing at all unless ads are live or placeholders are explicitly on.
const visible = live || showAdPlaceholders;
---

{
  visible && (
    <aside class="ad-slot" aria-label="Advertisement" data-ad-zone={slot}>
      <span class="ad-slot-tag">Advertisement</span>
      {live ? (
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={ads.adsenseClient}
          data-ad-slot={ads.inContentSlot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      ) : (
        <div class="ad-slot-placeholder">Ad space</div>
      )}
    </aside>
  )
}

{/* Request a fill for any ad units on the page (loader lives in Layout). */}
{
  live && (
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  )
}
