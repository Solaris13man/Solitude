---
import GameNav from './GameNav.astro';
import Footer from './Footer.astro';
import AdSlot from './AdSlot.astro';

interface VariantOption {
  value: number;
  label: string;
}

interface Props {
  gameId: string;
  heading: string;
  /** Options for the per-game mode select; omit when the game has none. */
  variantLabel?: string;
  variantOptions?: VariantOption[];
  /** HUD label for the third stat (defaults to Score; Sudoku uses Mistakes). */
  scoreLabel?: string;
  /** Hide card-specific settings (card back, left-handed) for non-card games. */
  cardSettings?: boolean;
  /** Show the Mahjong tile-design picker in Settings. */
  tileSettings?: boolean;
  /** Visible breadcrumb trail (matches the page's BreadcrumbList schema). */
  breadcrumb?: { name: string; href: string }[];
  /** Optional link to this game's in-depth strategy guide. */
  guide?: { href: string; label: string };
  /** Optional related guides (comparisons, winnability, difficulty) for the
   *  internal-link cluster — rendered as a compact row under the guide link. */
  related?: { href: string; label: string }[];
  /** Compact at-a-glance facts shown as one muted line under the board —
   *  orients newcomers and gives AI a liftable fact block. */
  keyFacts?: string[];
}

const {
  gameId,
  heading,
  variantLabel,
  variantOptions,
  scoreLabel = 'Score',
  cardSettings = true,
  tileSettings = false,
  breadcrumb,
  guide,
  related,
  keyFacts,
} = Astro.props;
---

<main class="mx-auto flex min-h-dvh w-full max-w-5xl flex-col px-2 sm:px-4">
  <a href="#board-region" class="skip-link">Skip to game board</a>
  <header class="flex flex-wrap items-center justify-between gap-2 py-3">
    <h1 class="text-xl font-extrabold tracking-tight sm:text-2xl">
      {heading}
      <a href="/" class="font-normal no-underline opacity-70 hover:underline">· CardHearth</a>
    </h1>
    <nav class="flex flex-wrap gap-1.5" aria-label="Game controls">
      <a href="/" class="btn" aria-label="Back to the game menu">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>
        <span class="btn-label">Home</span>
      </a>
      <details class="games-menu">
        <summary class="btn" aria-label="Browse all games">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span class="btn-label">Games</span>
        </summary>
        <div class="games-menu-panel">
          <GameNav current={gameId} />
        </div>
      </details>
      <button id="btn-new" class="btn" type="button" aria-label="New game">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>
        <span class="btn-label">New</span>
      </button>
      <button id="btn-undo" class="btn" type="button" disabled aria-label="Undo">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
        <span class="btn-label">Undo</span>
      </button>
      <button id="btn-redo" class="btn" type="button" disabled aria-label="Redo">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg>
        <span class="btn-label">Redo</span>
      </button>
      <button id="btn-hint" class="btn" type="button" aria-label="Hint">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3.9 10.6c.6.5.9 1.3.9 2.1V16h6v-.3c0-.8.3-1.6.9-2.1A6 6 0 0 0 12 3z"/></svg>
        <span class="btn-label">Hint</span>
      </button>
      <button id="btn-autofinish" class="btn btn-primary" type="button" hidden>
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 5 7 7-7 7"/><path d="m13 5 7 7-7 7"/></svg>
        Auto-finish
      </button>
      <button id="btn-stats" class="btn" type="button" aria-label="Statistics">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 20v-7"/><path d="M12 20V5"/><path d="M19 20v-11"/></svg>
        <span class="btn-label">Stats</span>
      </button>
      <button id="btn-settings" class="btn" type="button" aria-label="Settings">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h8"/><path d="M18 8h2"/><circle cx="15" cy="8" r="2.2"/><path d="M4 16h2"/><path d="M12 16h8"/><circle cx="9" cy="16" r="2.2"/></svg>
        <span class="btn-label">Settings</span>
      </button>
    </nav>
  </header>

  {
    breadcrumb && breadcrumb.length > 0 && (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        {breadcrumb.map((c, i) => (
          <>
            {i > 0 && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
            {i < breadcrumb.length - 1 ? (
              <a href={c.href}>{c.name}</a>
            ) : (
              <span aria-current="page">{c.name}</span>
            )}
          </>
        ))}
      </nav>
    )
  }

  <!-- Populated by the controller only when a game runs as today's daily. -->
  <div id="daily-banner" class="daily-banner" hidden></div>

  <!-- A labelled group, not a live region: the timer ticks every 500ms and
       would otherwise make screen readers announce the clock continuously. -->
  <div class="hud" role="group" aria-label="Game status">
    <span><span class="hud-label">Time</span><span id="stat-time">0:00</span></span>
    <span><span class="hud-label">Moves</span><span id="stat-moves">0</span></span>
    <span><span class="hud-label">{scoreLabel}</span><span id="stat-score">0</span></span>
    <span class="hud-deal" title="Deal number — share it to challenge a friend on the same cards"><span class="hud-label">Deal</span><span id="stat-deal">#0</span></span>
  </div>

  <div class="board-scroll" id="board-region" tabindex="-1">
    <div id="board" class="board" aria-label="Game board"></div>
  </div>

  {
    keyFacts && keyFacts.length > 0 && (
      <p class="key-facts" aria-label="At a glance">
        {keyFacts.map((f, i) => (
          <>
            {i > 0 && <span class="key-facts-sep" aria-hidden="true">·</span>}
            <span>{f}</span>
          </>
        ))}
      </p>
    )
  }

  <slot name="after-board" />

  <p class="visually-hidden" id="announcer" aria-live="polite"></p>
  <!-- aria-hidden: the live region above already announces the same text -->
  <div id="toast" class="toast" aria-hidden="true" hidden></div>

  <details id="instructions" class="instructions mx-auto w-full max-w-2xl" open>
    <summary class="instructions-summary">How to play, tips &amp; FAQ</summary>
    <div class="instructions-body text-sm leading-relaxed opacity-90">
      <slot />
    </div>
  </details>
  <script is:inline>
    // The rules render expanded by default so search engines and first-time
    // players see the full how-to/FAQ prose. Once a player has seen it on any
    // game, collapse it on later visits so returning players aren't nagged.
    try {
      if (localStorage.getItem('cardhearth:instructions-seen')) {
        document.getElementById('instructions')?.removeAttribute('open');
      } else {
        localStorage.setItem('cardhearth:instructions-seen', '1');
      }
    } catch (e) {}
    // The games dropdown overlays the board — close it on Escape or an
    // outside click/tap like any other popover.
    (function () {
      var menu = document.querySelector('details.games-menu');
      if (!menu) return;
      document.addEventListener('click', function (e) {
        if (menu.hasAttribute('open') && !menu.contains(e.target)) menu.removeAttribute('open');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.hasAttribute('open')) {
          menu.removeAttribute('open');
          var summary = menu.querySelector('summary');
          if (summary) summary.focus();
        }
      });
    })();
  </script>

  {
    guide && (
      <p class="game-guide-link">
        <a class="guide-cta" href={guide.href}>📖 {guide.label}</a>
      </p>
    )
  }

  {
    related && related.length > 0 && (
      <nav class="game-related mx-auto w-full max-w-2xl" aria-label="Related guides">
        <span class="game-related-label">Related:</span>
        {related.map((r) => (
          <a href={r.href}>{r.label}</a>
        ))}
      </nav>
    )
  }

  <section class="more-games mx-auto w-full max-w-2xl" aria-label="More games">
    <h2 class="more-games-title">More games</h2>
    <GameNav current={gameId} />
  </section>

  <AdSlot slot="in-content" />

  <Footer />
</main>

<dialog id="settings-dialog" aria-labelledby="settings-title">
  <p id="settings-title" class="dialog-title mb-2">Settings</p>
  {
    variantOptions && variantOptions.length > 0 && (
      <>
        <label class="field">
          {variantLabel ?? 'Mode'}
          <select id="set-variant">
            {variantOptions.map((v) => (
              <option value={String(v.value)}>{v.label}</option>
            ))}
          </select>
        </label>
        <p id="variant-note" class="text-xs opacity-70" hidden>
          The new mode applies to your next deal.
        </p>
      </>
    )
  }
  <label class="field">Theme
    <select id="set-theme">
      <option value="auto">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </label>
  <label class="field">Table surface
    <select id="set-surface">
      <option value="felt">Felt</option>
      <option value="wood-walnut">Walnut wood</option>
      <option value="wood-oak">Oak wood</option>
      <option value="marble">Marble</option>
      <option value="granite">Granite</option>
    </select>
  </label>
  <label class="field">{cardSettings ? 'Felt color' : 'Background'}
    <select id="set-felt">
      <option value="green">Green</option>
      <option value="blue">Blue</option>
      <option value="slate">Slate</option>
      <option value="crimson">Crimson</option>
    </select>
  </label>
  <label class="field" hidden={!cardSettings}>Card design
    <select id="set-cardset">
      <option value="new-blue">Modern · Blue back</option>
      <option value="new-red">Modern · Red back</option>
      <option value="vintage-blue">Vintage · Blue back</option>
      <option value="vintage-red">Vintage · Red back</option>
      <option value="ink">Ink · hand-drawn</option>
      <option value="classic">Classic (simple)</option>
    </select>
  </label>
  <label class="field" hidden={!cardSettings}>Card shadow (Ink)
    <input type="checkbox" id="set-ink-shadow" />
  </label>
  <label class="field" hidden={!cardSettings}>Card back (Classic)
    <select id="set-cardback">
      <option value="classic">Classic red</option>
      <option value="royal">Royal blue</option>
      <option value="mint">Mint</option>
      <option value="midnight">Midnight</option>
    </select>
  </label>
  {
    tileSettings && (
      <label class="field">Tile design
        <select id="set-tileset">
          <option value="china">China</option>
          <option value="japan">Japan</option>
          <option value="korea">Korea</option>
          <option value="india">India</option>
          <option value="medieval">Medieval</option>
        </select>
      </label>
    )
  }
  {
    cardSettings && (
      <label class="field">Left-handed layout
        <input type="checkbox" id="set-lefthand" />
      </label>
    )
  }
  <label class="field">Animations
    <input type="checkbox" id="set-animations" />
  </label>
  <label class="field">Sounds
    <input type="checkbox" id="set-sounds" />
  </label>
  <div class="mt-4 flex justify-end">
    <button class="btn btn-primary" type="button" data-close-dialog>Done</button>
  </div>
</dialog>

<dialog id="stats-dialog" aria-labelledby="stats-title">
  <p id="stats-title" class="dialog-title">Your statistics</p>
  <dl id="stats-body" class="stats-grid"></dl>
  <div class="flex justify-end">
    <button class="btn btn-primary" type="button" data-close-dialog>Close</button>
  </div>
</dialog>

<dialog id="win-dialog" aria-labelledby="win-title">
  <p id="win-title" class="dialog-title dialog-title-lg">🎉 You won!</p>
  <dl id="win-summary" class="stats-grid"></dl>
  {
    guide && (
      <p class="win-guide-cta mt-1 mb-3 text-sm opacity-90">
        Want to win more often? <a class="underline" href={guide.href}>{guide.label} →</a>
      </p>
    )
  }
  <div class="flex flex-wrap justify-end gap-2">
    <button class="btn" type="button" data-close-dialog>Close</button>
    <button id="btn-share" class="btn" type="button">Share deal</button>
    <button id="btn-replay-deal" class="btn" type="button">Replay deal</button>
    <button id="btn-play-again" class="btn btn-primary" type="button">New deal</button>
  </div>
</dialog>

<dialog id="newgame-dialog" aria-labelledby="newgame-title">
  <p id="newgame-title" class="dialog-title">Start a fresh game?</p>
  <p class="my-3 text-sm opacity-80">
    You haven't finished this one yet — starting fresh will reset your current win streak.
  </p>
  <div class="flex justify-end gap-2">
    <button class="btn" type="button" data-close-dialog>Keep playing</button>
    <button id="btn-confirm-new" class="btn btn-primary" type="button">Start fresh</button>
  </div>
</dialog>
