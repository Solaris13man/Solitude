---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const title = 'Spades — Play Free Online vs Computer | CardHearth';
const description =
  'Play Spades free in your browser with a computer partner against two AI opponents — bid your tricks, spades are always trump, go nil, and race your team to 500. No download, no sign-up.';

const faq = [
  {
    q: 'How do you play Spades?',
    a: 'Spades is a 4-player partnership trick-taking game. You and your partner (North) play against West and East. Each round you bid how many tricks you expect to take, then play 13 tricks. Spades are always trump, you must follow the led suit if you can, and you cannot lead a spade until spades are "broken". Your team scores by making its combined bid.',
  },
  {
    q: 'How does scoring work?',
    a: 'Make your team’s combined bid for 10 points per bid trick; each extra trick is a "bag" worth 1 point, but every 10 bags costs you 100. Miss your bid and you lose 10 per bid trick. Bidding "Nil" (zero) earns +100 if you take no tricks and -100 if you slip up. First team to 500 wins.',
  },
  {
    q: 'What is a nil bid?',
    a: 'A nil bid means you promise to take zero tricks that round. Pull it off and your team gets +100; take even one trick and it costs 100. Your partner still plays their own bid, so a nil can be a bold way to swing the game.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Spades',
    url: 'https://cardhearth.com/spades/',
    description,
    genre: 'Card game',
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    playMode: 'SinglePlayer',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: 'https://cardhearth.com/og/spades.png',
    publisher: { '@type': 'Organization', name: 'CardHearth', url: 'https://cardhearth.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CardHearth', item: 'https://cardhearth.com/' },
      { '@type': 'ListItem', position: 2, name: 'Spades', item: 'https://cardhearth.com/spades/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const bids = [{ v: 0, label: 'Nil' }, ...Array.from({ length: 13 }, (_, i) => ({ v: i + 1, label: String(i + 1) }))];
---

<Layout title={title} description={description} schema={schema}>
  <main class="mx-auto flex min-h-dvh w-full max-w-5xl flex-col px-2 sm:px-4">
    <header class="flex flex-wrap items-center justify-between gap-2 py-3">
      <h1 class="text-xl font-extrabold tracking-tight sm:text-2xl">
        Spades
        <a href="/" class="font-normal no-underline opacity-70 hover:underline">· CardHearth</a>
      </h1>
      <nav class="flex flex-wrap gap-1.5" aria-label="Game controls">
        <a href="/" class="btn" aria-label="Back to the game menu"><span class="btn-label">Home</span></a>
        <button id="btn-new" class="btn" type="button"><span class="btn-label">New game</span></button>
        <button id="btn-settings" class="btn" type="button"><span class="btn-label">Settings</span></button>
      </nav>
    </header>

    <div class="spades-scoreboard" id="spades-scoreboard" aria-live="polite"></div>

    <section class="hearts-table" aria-label="Spades table">
      <div class="seat seat-north">
        <span class="seat-chip" id="chip-north">North</span>
        <div class="opp-hand" id="hand-north"></div>
      </div>
      <div class="seat seat-west">
        <span class="seat-chip" id="chip-west">West</span>
        <div class="opp-hand" id="hand-west"></div>
      </div>
      <div class="hearts-center">
        <div class="hearts-trick" id="spades-trick"></div>
        <p class="hearts-status" id="spades-status" role="status" aria-live="polite"></p>
      </div>
      <div class="seat seat-east">
        <span class="seat-chip" id="chip-east">East</span>
        <div class="opp-hand" id="hand-east"></div>
      </div>
      <div class="seat seat-south">
        <div class="my-hand" id="spades-hand"></div>
        <div class="bid-bar" id="bid-bar" hidden>
          {bids.map((b) => (
            <button class="bid-btn" type="button" data-bid={b.v}>{b.label}</button>
          ))}
        </div>
        <span class="seat-chip seat-chip-you" id="chip-you">You</span>
      </div>
    </section>

    <section class="mx-auto max-w-2xl py-10 text-sm leading-relaxed opacity-90">
      <h2 class="mb-2 text-lg font-bold">How to play Spades</h2>
      <p class="mb-3">
        Spades is the classic four-player partnership game. You team up with <strong>North</strong>
        against <strong>West and East</strong>. Each round you <strong>bid</strong> how many tricks
        you'll take, then play 13 tricks where <strong>spades are always trump</strong>. Follow the
        led suit if you can; you can't lead a spade until spades are "broken".
      </p>
      <p class="mb-3">
        Make your team's combined bid for <strong>10 points per trick</strong>; extra tricks are
        "bags" worth 1 each, but every 10 bags costs you 100. Bid <strong>Nil</strong> (zero) for a
        +100 swing if you take no tricks — or -100 if you slip. First team to <strong>500</strong>
        wins.
      </p>
      <h2 class="mb-2 text-lg font-bold">Frequently asked questions</h2>
      {
        faq.map((f) => (
          <details class="faq mb-2">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 opacity-90">{f.a}</p>
          </details>
        ))
      }
      <p class="mt-4 opacity-75">
        Want more detail? Read the <a class="underline" href="/guides/spades-rules/">Spades rules</a>
        and the <a class="underline" href="/guides/spades-strategy/">Spades strategy guide</a>.
      </p>
      <p class="mt-4 opacity-75">
        Like trick-taking? Try <a class="underline" href="/hearts/">Hearts</a>.
      </p>
    </section>

    <Footer />
  </main>

  <dialog id="round-dialog" aria-labelledby="round-title">
    <p id="round-title" class="dialog-title">Round scored</p>
    <dl id="round-body" class="stats-grid"></dl>
    <div class="mt-4 flex justify-end">
      <button id="btn-round-continue" class="btn btn-primary" type="button">Next round</button>
    </div>
  </dialog>

  <dialog id="spades-over-dialog" aria-labelledby="spades-over-title">
    <p id="spades-over-title" class="dialog-title dialog-title-lg">Game over</p>
    <dl id="spades-over-body" class="stats-grid"></dl>
    <div class="mt-4 flex justify-end">
      <button id="btn-spades-again" class="btn btn-primary" type="button">New game</button>
    </div>
  </dialog>

  <dialog id="settings-dialog" aria-labelledby="settings-title">
    <p id="settings-title" class="dialog-title mb-2">Settings</p>
    <label class="field">Table surface
      <select id="set-surface">
        <option value="felt">Felt</option>
        <option value="wood-walnut">Walnut wood</option>
        <option value="wood-oak">Oak wood</option>
        <option value="marble">Marble</option>
        <option value="granite">Granite</option>
      </select>
    </label>
    <label class="field">Card design
      <select id="set-cardset">
        <option value="new-blue">Modern · Blue back</option>
        <option value="new-red">Modern · Red back</option>
        <option value="vintage-blue">Vintage · Blue back</option>
        <option value="vintage-red">Vintage · Red back</option>
        <option value="ink">Ink · hand-drawn</option>
        <option value="classic">Classic (simple)</option>
      </select>
    </label>
    <label class="field" id="field-ink-shadow" hidden>Card shadow
      <input type="checkbox" id="set-ink-shadow" />
    </label>
    <label class="field">Theme
      <select id="set-theme">
        <option value="auto">System</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
    </label>
    <label class="field">Sounds
      <input type="checkbox" id="set-sounds" />
    </label>
    <div class="mt-4 flex justify-end">
      <button class="btn btn-primary" type="button" data-close-dialog>Done</button>
    </div>
  </dialog>

  <script>
    import { startSpades } from '../games/spades/controller';
    startSpades();
  </script>
</Layout>
