const updated = '2026-06-13';
const heading = 'TriPeaks Solitaire Rules';
const subtitle =
  'A clear, complete reference for how TriPeaks is dealt, which moves are legal, how scoring works, and exactly what it takes to win.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'TriPeaks Solitaire Rules', href: '/guides/tripeaks-solitaire-rules/' },
];

const faq = [
  {
    q: 'Does the rank wrap around (King to Ace)?',
    a: 'Yes. Rank wraps in both directions, so an Ace and a King count as adjacent: you can play a King onto an Ace and an Ace onto a King. Combined with the normal up-or-down rule, this lets long chains ride right through the wrap — for example Queen, King, Ace, 2.',
  },
  {
    q: 'How do streaks work?',
    a: 'Each card you clear without drawing extends a streak, and the streak determines the points: the first card in a run scores 10, the next 20, the next 30, and so on, increasing by 10 each time. Drawing a card from the stock resets the streak back to zero, so the next clear starts again at 10. That makes long, unbroken chains far more valuable than the same cards cleared one at a time.',
  },
  {
    q: 'How many cards are in the three peaks?',
    a: 'The tableau holds 28 cards arranged as three peaks: one card at each apex, then a row of six, a row of nine, and a fully exposed base row of ten. The remaining 24 cards become the first waste card plus a 23-card stock.',
  },
];

const schema = [
  {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to play TriPeaks Solitaire",
      "description": "The complete rules of TriPeaks Solitaire, step by step.",
      "mainEntityOfPage": "https://cardhearth.com/guides/tripeaks-solitaire-rules/",
      "step": [
          {
              "@type": "HowToStep",
              "position": 1,
              "name": "Set up three peaks",
              "text": "Deal 28 cards into three overlapping pyramids — the three peaks — with face-up cards available along the base, and keep the rest as a stock."
          },
          {
              "@type": "HowToStep",
              "position": 2,
              "name": "Know the goal",
              "text": "Clear every card from all three peaks."
          },
          {
              "@type": "HowToStep",
              "position": 3,
              "name": "Play one rank up or down",
              "text": "Take any exposed peak card that is exactly one rank above or below the top card of your waste pile. Rank wraps, so an Ace can follow a King and a King can follow an Ace."
          },
          {
              "@type": "HowToStep",
              "position": 4,
              "name": "Chain long streaks",
              "text": "Each card you clear becomes the new base for the next, so consecutive plays build a streak that scores more the longer it runs."
          },
          {
              "@type": "HowToStep",
              "position": 5,
