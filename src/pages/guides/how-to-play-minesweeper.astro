];

const faq = [
  {
    q: 'Is the first click always safe?',
    a: 'Yes, on CardHearth. The mines are placed only after your first reveal, and the game avoids both the square you clicked and the squares around it. That means your opening move can never detonate a mine and always opens a small safe area to start reading from.',
  },
  {
    q: 'What do the numbers mean?',
    a: 'A number on a revealed square counts the mines hidden in its eight neighbouring squares (up, down, left, right, and the four diagonals). A 1 means exactly one of those neighbours is a mine; a 3 means three of them are. A square with no number at all is a 0 — none of its neighbours are mines.',
  },
  {
