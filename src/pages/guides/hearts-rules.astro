const title = 'Hearts Rules: How to Play (Complete Guide) | CardHearth';
const description =
  'A complete guide to the rules of Hearts: the deal, passing, the two of clubs lead, following suit, breaking hearts, scoring the hearts and the Queen of Spades, shooting the moon, and how to win.';
const updated = '2026-06-14';
const heading = 'Hearts Rules: How to Play';
const subtitle =
  'Everything you need to play Hearts correctly — the deal and the pass, how a trick is won, why you avoid hearts and the Queen of Spades, and the one bold play that flips the whole game.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Hearts Rules', href: '/guides/hearts-rules/' },
];

const faq = [
  {
    q: 'Who leads the first trick in Hearts?',
    a: 'Whoever holds the two of clubs must lead it to start the first trick of every hand. Play then proceeds clockwise, and everyone must follow the led suit if they can.',
  },
  {
    q: 'What does "breaking hearts" mean?',
    a: 'You cannot lead a heart until hearts have been "broken" — that is, until someone has been unable to follow suit and has discarded a heart (or the Queen of Spades) on an earlier trick. Once hearts are broken, they may be led like any other suit.',
  },
  {
    q: 'What is shooting the moon?',
    a: 'If you manage to take every single point in a hand — all thirteen hearts and the Queen of Spades, 26 points in total — you "shoot the moon". Instead of taking 26 points, you score zero and all three opponents take 26 each. It is the game’s biggest swing.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Hearts Rules: How to Play (Complete Guide)',
    description,
    datePublished: updated,
    dateModified: updated,
    author: { '@type': 'Organization', name: 'CardHearth' },
    publisher: {
      '@type': 'Organization',
      name: 'CardHearth',
      url: 'https://cardhearth.com/',
      logo: { '@type': 'ImageObject', url: 'https://cardhearth.com/logo.png' },
    },
    mainEntityOfPage: 'https://cardhearth.com/guides/hearts-rules/',
    image: 'https://cardhearth.com/og/hearts.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
