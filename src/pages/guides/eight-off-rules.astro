const subtitle =
  'Everything you need to play Eight Off correctly — the setup with eight free cells, the same-suit building that sets it apart from FreeCell, and the arithmetic behind moving several cards at once.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
