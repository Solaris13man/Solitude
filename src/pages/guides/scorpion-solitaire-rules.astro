---
import Article from '../../components/Article.astro';

const title = 'Scorpion Solitaire Rules: How to Play (Complete Guide) | CardHearth';
const description =
  'Learn the rules of Scorpion Solitaire: the deal, building down in suit, moving any pile regardless of order, the three-card stock, and how to win.';
const updated = '2026-06-14';
const heading = 'Scorpion Solitaire Rules: How to Play';
const subtitle =
  'Everything you need to play Scorpion correctly — the deal, same-suit building, the move-any-group rule that gives the game its sting, and the one-time stock.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Scorpion Solitaire Rules', href: '/guides/scorpion-solitaire-rules/' },
];

const faq = [
  {
    q: 'How is Scorpion different from Spider?',
    a: 'Both build down in suit and both aim for full King-to-Ace runs, so they feel related. The difference is how you move cards. Spider only lets you pick up a run that is already in order. Scorpion lets you lift any face-up card together with everything stacked on top of it — even a jumbled, out-of-order pile — and drop the whole group onto a same-suit card one rank higher. That single rule changes how you plan every move.',
  },
  {
    q: 'Can I deal the stock more than once?',
    a: 'No. Scorpion has just three cards left over after the tableau is dealt, and you deal them out only once — one card face up onto each of the first three columns. There is no recycling and no second pass, so save that deal for a moment when the three new cards will actually help.',
  },
  {
    q: 'What goes on an empty column?',
    a: 'Only a King, along with any cards sitting on top of it. Because clearing a column is hard and refilling it is restricted, empty columns are precious. Plan to land a King there, ideally with a useful run already attached, rather than emptying a column with nothing ready to fill it.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Scorpion Solitaire Rules: How to Play (Complete Guide)',
    description,
    datePublished: updated,
    dateModified: updated,
    author: { '@type': 'Person', '@id': 'https://cardhearth.com/#jared', name: 'Jared Waterworth', url: 'https://cardhearth.com/about/' },
    publisher: {
      '@type': 'Organization',
      name: 'CardHearth',
      url: 'https://cardhearth.com/',
      logo: { '@type': 'ImageObject', url: 'https://cardhearth.com/logo.png' },
    },
    mainEntityOfPage: 'https://cardhearth.com/guides/scorpion-solitaire-rules/',
    image: 'https://cardhearth.com/og/scorpion.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `https://cardhearth.com${c.href}`,
    })),
