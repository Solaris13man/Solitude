const updated = '2026-06-13';
const heading = 'What Is Mahjong Solitaire?';
const subtitle =
  'A plain-English reference to the rules of the single-player tile-matching game — the tiles, the layout, the matches, and how a board is won.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'What Is Mahjong Solitaire?', href: '/guides/what-is-mahjong-solitaire/' },
];

const faq = [
  {
    q: 'Is Mahjong Solitaire the same as Mahjong?',
    a: 'No. Mahjong is a four-player game played with hands, draws and discards, scored a bit like rummy. Mahjong Solitaire is a single-player puzzle: you simply remove matching pairs of tiles from a fixed layout until the board is clear. The two games share the same 144 tiles, but the goals and rules are entirely different.',
  },
  {
    q: 'When is a tile playable?',
    a: 'A tile is "free" (selectable) when two things are true at once: nothing rests on top of it, and at least one of its long sides — left or right — is open. If a tile is buried under another tile, or boxed in on both the left and right, it is locked until you clear the tiles around it.',
  },
  {
    q: 'Do flowers and seasons match each other?',
    a: 'Within their own group, yes. Any flower matches any other flower, and any season matches any other season — those are the only "mixed" matches in the game. Every other tile (the suits, winds and dragons) must be paired with an exact identical twin.',
