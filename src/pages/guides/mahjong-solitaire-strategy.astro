const faq = [
  {
    q: 'Are all CardHearth Mahjong games winnable?',
    a: 'Yes — every CardHearth deal is built by reverse-construction, laying tiles down as solvable pairs, so a complete solution always exists. But "solvable" is not the same as "automatically won." If you remove the wrong pairs you can still strand the remaining tiles in a dead end. When that happens, undo and try a different removal order rather than starting over.',
  },
