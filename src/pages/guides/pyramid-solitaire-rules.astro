const updated = '2026-06-13';
const heading = 'Pyramid Solitaire Rules';
const subtitle =
  'Everything you need to know to play Pyramid: the layout, what the cards are worth, which moves are legal, and how you win.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Pyramid Solitaire Rules', href: '/guides/pyramid-solitaire-rules/' },
];

const faq = [
  {
    q: 'What do cards add up to in Pyramid Solitaire?',
    a: 'Thirteen. You remove two exposed cards whose ranks sum to 13 — Queen+Ace, Jack+2, 10+3, 9+4, 8+5 and 7+6. Ace counts 1, Jack 11 and Queen 12.',
  },
  {
    q: 'What do Kings pair with in Pyramid Solitaire?',
    a: 'Nothing — a King is worth 13 on its own, so it is removed by itself with a single tap whenever it is exposed. Kings never need a partner.',
  },
  {
    q: 'Are all Pyramid Solitaire games winnable?',
    a: 'No. Pyramid has one of the lower win rates among popular solitaires because a card you need can be buried beneath its own partner, making some deals impossible. Unlimited undo lets you explore lines, and every deal is numbered so you can retry it.',
  },
];

const schema = [
  {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to play Pyramid Solitaire",
      "description": "The complete rules of Pyramid Solitaire, step by step.",
      "mainEntityOfPage": "https://cardhearth.com/guides/pyramid-solitaire-rules/",
      "step": [
          {
              "@type": "HowToStep",
              "position": 1,
              "name": "Set up the pyramid",
              "text": "Deal 28 cards into a pyramid of seven overlapping rows, then keep the rest as a stock with a waste pile."
          },
          {
              "@type": "HowToStep",
              "position": 2,
              "name": "Know the goal",
              "text": "Remove all the cards by pairing them to a total of 13."
          },
          {
              "@type": "HowToStep",
              "position": 3,
              "name": "Pair exposed cards to 13",
              "text": "Remove two uncovered cards whose ranks add to 13 — a 5 with an 8, a 4 with a 9, an Ace with a Queen. A King is worth 13 and is removed on its own."
          },
          {
              "@type": "HowToStep",
              "position": 4,
              "name": "Free covered cards",
              "text": "A card can only be played once both cards resting on top of it have been removed, so plan which pairs to take first."
          },
