const updated = '2026-06-13';
const heading = 'Pyramid Solitaire Strategy';
const subtitle =
  'Why most Pyramid games are won or lost in the first few moves — and the planning habits that clear the whole pyramid.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Pyramid Solitaire Strategy', href: '/guides/pyramid-solitaire-strategy/' },
];

const faq = [
  {
    q: 'Are all Pyramid Solitaire games winnable?',
    a: 'No. Whether a deal can be cleared depends entirely on the shuffle — some layouts trap a needed card under cards that can only be removed with it, so they are impossible no matter how well you play. That is normal for Pyramid. On CardHearth, unlimited undo and numbered, replayable deals let you experiment and learn which lines work without losing progress.',
  },
  {
    q: 'What do Kings pair with in Pyramid?',
    a: 'Nothing. A King already equals 13 on its own (A=1, J=11, Q=12, K=13), so it is removed by itself the moment it is exposed. There is never a reason to leave a King sitting on the pyramid — take it whenever you can.',
  },
  {
    q: 'How does clearing and scoring work?',
    a: 'You clear the board by removing every card from the pyramid in pairs that add up to 13, plus Kings removed alone. You win when the pyramid is empty. Most scoring rewards clearing the full pyramid (and sometimes the stock too); the practical goal is simply to empty the pyramid before you run out of usable stock passes.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Pyramid Solitaire Strategy & Tips',
    description,
    datePublished: updated,
    dateModified: updated,
    author: { '@type': 'Organization', name: 'CardHearth' },
    publisher: {
      '@type': 'Organization',
