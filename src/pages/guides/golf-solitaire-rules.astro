const updated = '2026-06-13';
const heading = 'Golf Solitaire Rules';
const subtitle =
  'How to play Golf Solitaire from the deal to the win — a clear, complete reference to the setup, the legal moves, and how a hand ends.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Golf Solitaire Rules', href: '/guides/golf-solitaire-rules/' },
];

const faq = [
  {
    q: 'Does Golf Solitaire wrap from King to Ace?',
    a: 'No. On CardHearth, the rank sequence does not wrap: a King and an Ace are not adjacent. Only a Queen plays on a King, and only a 2 plays on an Ace. The chain simply stops at each end.',
  },
  {
    q: 'Can you recycle the stock in Golf Solitaire?',
    a: 'No. The stock is dealt face down and turned one card at a time. Once it is empty, it is gone — there is no recycling or redealing. When no column card plays and the stock is empty, the hand is over.',
  },
  {
    q: 'How many cards are in Golf Solitaire?',
    a: 'A standard 52-card deck. Of those, 35 are dealt face up into seven columns of five, one card starts the waste pile, and the remaining 16 form the face-down stock.',
  },
];

const schema = [
