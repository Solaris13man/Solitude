      "@type": "HowTo",
      "name": "How to play Golf Solitaire",
      "description": "The complete rules of Golf Solitaire, step by step.",
      "mainEntityOfPage": "https://cardhearth.com/guides/golf-solitaire-rules/",
      "step": [
          {
