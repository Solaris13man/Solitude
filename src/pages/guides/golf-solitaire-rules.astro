              "@type": "HowToStep",
              "position": 3,
              "name": "Play up or down by one",
              "text": "Move any exposed column card onto the waste if it is one rank higher or lower, regardless of suit — a 7 onto a 6 or an 8."
          },
          {
              "@type": "HowToStep",
              "position": 4,
              "name": "Note the no-wrap rule",
              "text": "Rank does not wrap: you cannot play an Ace on a King or a King on an Ace, so an Ace can end a sequence."
          },
          {
              "@type": "HowToStep",
              "position": 5,
              "name": "Turn the stock when stuck",
              "text": "When no column card fits, flip the next stock card to the waste and continue."
          },
