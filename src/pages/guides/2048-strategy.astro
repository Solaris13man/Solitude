const updated = '2026-06-13';
const heading = '2048 Strategy: How to Reach 2048 (and Beyond)';
const subtitle =
  'The corner-and-snake method that turns 2048 from a lucky scramble into a game you can win on purpose — with the reasoning behind each rule.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: '2048 Strategy', href: '/guides/2048-strategy/' },
];

const faq = [
  {
    q: "What's the best corner strategy for 2048?",
    a: 'Pick one corner — bottom-right and bottom-left are the most popular — and keep your single largest tile there for the entire game. Then build a descending "snake" of tiles leading into that corner and only swipe in the two directions that push tiles toward it (for a bottom-right anchor, that means down and right). The corner gives your biggest tile a permanent home so it never gets shuffled into the middle, and the snake lets smaller merges cascade up into it.',
  },
  {
    q: 'Can I keep playing after I reach 2048?',
    a: 'Yes. Reaching the 2048 tile is the official win, but the board does not end there — you can keep going to build 4096, 8192 and higher. The exact same strategy applies: keep your biggest tile anchored in its corner and keep feeding the snake. The board just gets tighter, so planning matters even more.',
  },
  {
    q: 'How do you lose at 2048?',
    a: 'You lose when the board is completely full and no two adjacent tiles can merge in any direction — there is simply no legal move left. It usually happens after you swipe in a "forbidden" direction that pulls your anchor tile out of its corner, or after you fill the board with mismatched values that have nowhere to combine. Planning merges before the board gets tight is how you avoid it.',
  },
];

const schema = [
