---
import Article from '../../components/Article.astro';

const title = 'Golf Solitaire Strategy & Tips | CardHearth';
const description =
  'A clear, practical Golf Solitaire strategy guide: plan card chains before you commit, clear the tallest columns, conserve your stock draws, and reverse direction to extend long runs.';
const updated = '2026-06-13';
const heading = 'Golf Solitaire Strategy';
const subtitle =
  'Golf rewards planning over speed. Learn to read chains, spend stock draws wisely, and clear the board on more deals.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Golf Solitaire Strategy', href: '/guides/golf-solitaire-strategy/' },
];

const faq = [
  {
    q: 'Does the rank wrap around in Golf?',
    a: 'No. On CardHearth, rank does not wrap around: an Ace and a King are not adjacent. You can only play a card that is exactly one rank higher or lower than the current waste card (so a 7 accepts a 6 or an 8). When the waste shows an Ace you can only play a 2 on top of it, and a King only accepts a Queen.',
  },
  {
    q: 'When should I draw from the stock?',
    a: 'Only when no tableau move advances your plan. Each draw is one-way — there is no recycling the stock in Golf — so every card you turn over is spent for good. Exhaust the useful tableau plays first, then draw to open a fresh chain.',
  },
  {
    q: 'Are all Golf deals winnable?',
    a: 'No. Some deals cannot be cleared no matter how you play, because the cards needed to bridge between columns are buried or the stock runs out first. CardHearth gives every deal a number, so you can replay a tough one to test a better line, and unlimited undo lets you explore without penalty.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Golf Solitaire Strategy & Tips',
    description,
    datePublished: updated,
    dateModified: updated,
    author: { '@type': 'Organization', name: 'CardHearth' },
    publisher: {
      '@type': 'Organization',
      name: 'CardHearth',
      url: 'https://cardhearth.com/',
      logo: { '@type': 'ImageObject', url: 'https://cardhearth.com/logo.png' },
    },
    mainEntityOfPage: 'https://cardhearth.com/guides/golf-solitaire-strategy/',
    image: 'https://cardhearth.com/og/golf.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `https://cardhearth.com${c.href}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
