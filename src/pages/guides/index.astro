---

<Layout title={title} description={description} schema={schema}>
  <main class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-4">
    <nav class="breadcrumb pt-6" aria-label="Breadcrumb">
      <a href="/">CardHearth</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span aria-current="page">Guides</span>
    </nav>

    <header class="pt-4 pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Game Guides & Strategy</h1>
      <p class="mt-3 text-lg opacity-80">
        Clear, practical strategy for the games on CardHearth — written to actually help you win
        more, not to pad a page. Every guide links straight to a game so you can practise as you
        read.
      </p>
    </header>

    <section class="pb-8">
      <h2 class="guide-section-title">Rules &amp; how to play</h2>
      <div class="guide-grid">
        {
          RULES.map((g) => (
            <a class="guide-card" href={g.href}>
              <h3>{g.title}</h3>
              <p>{g.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="pb-8">
      <h2 class="guide-section-title">Strategy guides</h2>
      <div class="guide-grid">
        {
          GUIDES.map((g) => (
            <a class="guide-card" href={g.href}>
              <h3>{g.title}</h3>
              <p>{g.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="pb-8">
      <h2 class="guide-section-title">Compare &amp; choose</h2>
      <div class="guide-grid">
        {
          COMPARISONS.map((g) => (
            <a class="guide-card" href={g.href}>
              <h3>{g.title}</h3>
              <p>{g.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="pb-10">
      <h2 class="guide-section-title">Background &amp; reference</h2>
      <div class="guide-grid">
        {
          REFERENCE.map((g) => (
            <a class="guide-card" href={g.href}>
              <h3>{g.title}</h3>
              <p>{g.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <Footer />
  </main>
</Layout>
