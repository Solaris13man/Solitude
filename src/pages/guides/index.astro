---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const title = 'Game Guides & Strategy — Solitaire, Sudoku & More | CardHearth';
const description =
  'Free strategy guides for Klondike, Spider and FreeCell Solitaire, Sudoku solving techniques, and a roundup of the best free games to play in your browser.';

const GUIDES = [
  {
    href: '/guides/how-to-win-klondike-solitaire/',
    title: 'How to Win Klondike Solitaire',
    blurb: 'The handful of habits that take you from a 10% win rate to nearly 50%.',
  },
  {
    href: '/guides/spider-solitaire-strategy/',
    title: 'Spider Solitaire Strategy',
    blurb: 'Build same-suit runs, free columns, and tame the 2- and 4-suit games.',
  },
  {
    href: '/guides/freecell-strategy/',
    title: 'FreeCell Strategy',
    blurb: 'Almost every deal is winnable — here is how to actually win them.',
  },
  {
    href: '/guides/pyramid-solitaire-strategy/',
    title: 'Pyramid Solitaire Strategy',
    blurb: 'Pair cards to thirteen without stranding the partners you need.',
  },
  {
    href: '/guides/tripeaks-solitaire-strategy/',
    title: 'TriPeaks Solitaire Strategy',
    blurb: 'Build the longest streaks and clear all three peaks.',
  },
  {
    href: '/guides/golf-solitaire-strategy/',
    title: 'Golf Solitaire Strategy',
    blurb: 'Plan your sequences and clear the course in quick rounds.',
  },
  {
    href: '/guides/sudoku-solving-techniques/',
    title: 'Sudoku Solving Techniques',
    blurb: 'From naked singles to X-Wing: the logic to solve any fair puzzle without guessing.',
  },
  {
    href: '/guides/mahjong-solitaire-strategy/',
    title: 'Mahjong Solitaire Strategy',
    blurb: 'Every deal is solvable — match the right pairs and don’t strand yourself.',
  },
  {
    href: '/guides/minesweeper-strategy/',
    title: 'Minesweeper Strategy',
    blurb: 'Read the numbers, learn the patterns, and guess only when you must.',
  },
  {
    href: '/guides/2048-strategy/',
    title: '2048 Strategy',
    blurb: 'The corner-and-snake method to reach the 2048 tile and beyond.',
  },
  {
    href: '/guides/best-free-solitaire-and-puzzle-games/',
    title: 'The Best Free Solitaire & Puzzle Games',
    blurb: 'A quick tour of every game on CardHearth and which one fits your mood.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'CardHearth Game Guides',
    description,
    url: 'https://cardhearth.com/guides/',
    isPartOf: { '@type': 'WebSite', name: 'CardHearth', url: 'https://cardhearth.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CardHearth', item: 'https://cardhearth.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://cardhearth.com/guides/' },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-4">
    <nav class="breadcrumb pt-6" aria-label="Breadcrumb">
      <a href="/">CardHearth</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span aria-current="page">Guides</span>
    </nav>

    <header class="pt-4 pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Game Guides & Strategy</h1>
      <p class="mt-3 text-lg opacity-80">
        Clear, practical strategy for the games on CardHearth — written to actually help you win
        more, not to pad a page. Every guide links straight to a game so you can practise as you
        read.
      </p>
    </header>

    <div class="guide-grid pb-10">
      {
        GUIDES.map((g) => (
          <a class="guide-card" href={g.href}>
            <h2>{g.title}</h2>
            <p>{g.blurb}</p>
          </a>
        ))
      }
    </div>

    <Footer />
  </main>
</Layout>
