---
import Article from '../../components/Article.astro';

const title = 'Forty Thieves Rules: How to Play (Complete Guide) | CardHearth';
const description =
  'Learn the rules of Forty Thieves: the two-deck deal, building down in suit, moving one card at a time, the stock and waste, and how to win this tough game.';
const updated = '2026-06-14';
const heading = 'Forty Thieves Rules: How to Play';
const subtitle =
  'Everything you need to play Forty Thieves correctly — the two-deck deal, the strict same-suit builds, the single-card moves, and why this is one of the hardest solitaires around.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Forty Thieves Rules', href: '/guides/forty-thieves-rules/' },
];

const faq = [
  {
    q: 'How many decks does Forty Thieves use?',
    a: 'Two. You shuffle two standard 52-card decks together for 104 cards in total, which is why there are eight foundations — two of each suit — rather than the usual four. The extra deck is a large part of what makes the game so demanding.',
  },
  {
    q: 'Can you move more than one card at a time?',
    a: 'No. Forty Thieves only ever moves a single card between tableau columns. To relocate a run you move its cards one at a time, parking them on other columns or in empty spaces and rebuilding the run elsewhere. That restriction, combined with same-suit building, is what makes the game so tight.',
  },
  {
    q: 'Can you redeal the stock?',
    a: 'No. You turn the stock one card at a time onto the waste pile, and once the stock is exhausted it is gone — there is no redeal. Every card you flip is a card you may never see again, so the order you take from the waste matters a great deal.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Forty Thieves Rules: How to Play (Complete Guide)',
    description,
    datePublished: updated,
    dateModified: updated,
    author: { '@type': 'Person', name: 'Jared', url: 'https://cardhearth.com/about/' },
    publisher: {
      '@type': 'Organization',
      name: 'CardHearth',
      url: 'https://cardhearth.com/',
      logo: { '@type': 'ImageObject', url: 'https://cardhearth.com/logo.png' },
    },
    mainEntityOfPage: 'https://cardhearth.com/guides/forty-thieves-rules/',
    image: 'https://cardhearth.com/og/forty-thieves.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `https://cardhearth.com${c.href}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
