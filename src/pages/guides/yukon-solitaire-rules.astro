const heading = 'Yukon Solitaire Rules: How to Play';
const subtitle =
  'Everything you need to play Yukon correctly — the deal, the objective, and the one rule that sets it apart from Klondike: you can move any face-up group, in order or not.';

const breadcrumb = [
  { name: 'CardHearth', href: '/' },
