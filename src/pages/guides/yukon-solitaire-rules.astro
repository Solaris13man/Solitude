  { name: 'Yukon Solitaire Rules', href: '/guides/yukon-solitaire-rules/' },
];

const faq = [
  {
    q: 'Can you really move a group of cards that is out of order in Yukon?',
    a: 'Yes — this is Yukon\'s signature rule. You may pick up any face-up card along with every card stacked on top of it and move the whole group, even if those cards are not in sequence or alternating colour. Only the card you actually grab has to land legally: one rank lower and the opposite colour of its destination. The cards riding along on top can be anything.',
  },
  {
    q: 'Is there a stock or waste pile in Yukon?',
    a: 'No. Every card is on the table from the start, and there is nothing left to draw. All moves are made between the seven tableau columns and the four foundations, so the whole game is open information once the down cards are turned over.',
  },
