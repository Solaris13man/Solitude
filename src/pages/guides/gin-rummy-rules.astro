const heading = 'Gin Rummy Rules: How to Play';
const subtitle =
  'Everything you need to play Gin Rummy correctly — building sets and runs, what deadwood is, when you can knock, going gin, and the undercut that punishes a sloppy knock.';

const breadcrumb = [
