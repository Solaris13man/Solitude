---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const title = 'Euchre — Play Free Online vs Computer | CardHearth';
const description =
  'Play Euchre free in your browser with a computer partner against two AI opponents — order up trump, name the bowers, go alone, and race your team to 10. No download, no sign-up.';

const faq = [
  {
    q: 'How do you play Euchre?',
    a: 'Euchre is a 4-player partnership game played with a 24-card deck (9 through Ace). You partner with North against West and East. Each hand, one card is turned up; going around the table you can "order it up" to make its suit trump, or pass. If everyone passes, a second round lets you name a different suit. The team that names trump must win at least 3 of the 5 tricks.',
  },
  {
    q: 'What are the bowers?',
    a: 'The Jack of the trump suit is the "right bower" — the highest card in the game. The Jack of the same color as trump (for example, the Jack of diamonds when hearts are trump) is the "left bower", the second-highest card, and it counts as a trump rather than its printed suit. After the bowers come Ace, King, Queen, Ten, Nine of trump.',
  },
  {
    q: 'How does scoring work?',
    a: 'The team that calls trump (the "makers") scores 1 point for taking 3 or 4 tricks, or 2 points for all 5 (a "march"). If the makers fail to take 3 tricks they are "euchred" and the other team scores 2. You can also choose to "go alone" — your partner sits out, and winning all 5 alone scores 4. First team to 10 points wins.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Euchre',
    url: 'https://cardhearth.com/euchre/',
    description,
    genre: 'Card game',
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    playMode: 'SinglePlayer',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: 'https://cardhearth.com/og/euchre.png',
    publisher: { '@type': 'Organization', name: 'CardHearth', url: 'https://cardhearth.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CardHearth', item: 'https://cardhearth.com/' },
      { '@type': 'ListItem', position: 2, name: 'Euchre', item: 'https://cardhearth.com/euchre/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="mx-auto flex min-h-dvh w-full max-w-5xl flex-col px-2 sm:px-4">
    <header class="flex flex-wrap items-center justify-between gap-2 py-3">
      <h1 class="text-xl font-extrabold tracking-tight sm:text-2xl">
        Euchre
        <a href="/" class="font-normal no-underline opacity-70 hover:underline">· CardHearth</a>
      </h1>
      <nav class="flex flex-wrap gap-1.5" aria-label="Game controls">
        <a href="/" class="btn" aria-label="Back to the game menu"><span class="btn-label">Home</span></a>
        <button id="btn-new" class="btn" type="button"><span class="btn-label">New game</span></button>
        <button id="btn-settings" class="btn" type="button"><span class="btn-label">Settings</span></button>
      </nav>
    </header>

    <div class="spades-scoreboard" id="euchre-scoreboard" aria-live="polite"></div>

    <section class="hearts-table" aria-label="Euchre table">
      <div class="seat seat-north">
        <span class="seat-chip" id="chip-north">North</span>
        <div class="opp-hand" id="hand-north"></div>
      </div>
      <div class="seat seat-west">
        <span class="seat-chip" id="chip-west">West</span>
        <div class="opp-hand" id="hand-west"></div>
      </div>
      <div class="hearts-center">
        <div class="euchre-up" id="euchre-up" hidden></div>
        <div class="hearts-trick" id="euchre-trick"></div>
        <p class="hearts-status" id="euchre-status" role="status" aria-live="polite"></p>
      </div>
      <div class="seat seat-east">
        <span class="seat-chip" id="chip-east">East</span>
        <div class="opp-hand" id="hand-east"></div>
      </div>
      <div class="seat seat-south">
        <div class="my-hand" id="euchre-hand"></div>
        <div class="euchre-bid" id="euchre-bid" hidden></div>
        <span class="seat-chip seat-chip-you" id="chip-you">You</span>
      </div>
    </section>

    <section class="mx-auto max-w-2xl py-10 text-sm leading-relaxed opacity-90">
      <h2 class="mb-2 text-lg font-bold">How to play Euchre</h2>
      <p class="mb-3">
        Euchre is a fast four-player partnership game played with just 24 cards (9 up to Ace). You
        team up with <strong>North</strong> against <strong>West and East</strong>. One card is
        turned up; going around the table you can <strong>order it up</strong> to make its suit
        trump, or pass. If everyone passes, a second round lets you <strong>name</strong> a different
        suit. Whoever calls trump must take at least <strong>3 of the 5 tricks</strong>.
      </p>
      <p class="mb-3">
        The <strong>right bower</strong> (Jack of trump) is the highest card, and the
        <strong>left bower</strong> (the other Jack of the same color) ranks just below it and counts
        as trump. Take 3 or 4 tricks for 1 point, all 5 for 2, or <strong>go alone</strong> and sweep
        all five for 4. Miss your bid and you're <strong>euchred</strong> — the other team scores 2.
        First to <strong>10</strong> wins.
      </p>
      <h2 class="mb-2 text-lg font-bold">Frequently asked questions</h2>
      {
        faq.map((f) => (
          <details class="faq mb-2">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 opacity-90">{f.a}</p>
          </details>
        ))
      }
      <p class="mt-6 opacity-75">
        Like trick-taking? Try <a class="underline" href="/spades/">Spades</a> or
        <a class="underline" href="/hearts/">Hearts</a>.
      </p>
    </section>

    <Footer />
  </main>

  <dialog id="round-dialog" aria-labelledby="round-title">
    <p id="round-title" class="dialog-title">Round scored</p>
    <dl id="round-body" class="stats-grid"></dl>
    <div class="mt-4 flex justify-end">
      <button id="btn-round-continue" class="btn btn-primary" type="button">Next hand</button>
    </div>
  </dialog>

  <dialog id="euchre-over-dialog" aria-labelledby="euchre-over-title">
    <p id="euchre-over-title" class="dialog-title dialog-title-lg">Game over</p>
    <dl id="euchre-over-body" class="stats-grid"></dl>
    <div class="mt-4 flex justify-end">
      <button id="btn-euchre-again" class="btn btn-primary" type="button">New game</button>
    </div>
  </dialog>

  <dialog id="settings-dialog" aria-labelledby="settings-title">
    <p id="settings-title" class="dialog-title mb-2">Settings</p>
    <label class="field">Table surface
      <select id="set-surface">
        <option value="felt">Felt</option>
        <option value="wood-walnut">Walnut wood</option>
        <option value="wood-oak">Oak wood</option>
        <option value="marble">Marble</option>
        <option value="granite">Granite</option>
      </select>
    </label>
    <label class="field">Card design
      <select id="set-cardset">
        <option value="new-blue">Modern · Blue back</option>
        <option value="new-red">Modern · Red back</option>
        <option value="vintage-blue">Vintage · Blue back</option>
        <option value="vintage-red">Vintage · Red back</option>
        <option value="ink">Ink · hand-drawn</option>
        <option value="classic">Classic (simple)</option>
      </select>
    </label>
    <label class="field" id="field-ink-shadow" hidden>Card shadow
      <input type="checkbox" id="set-ink-shadow" />
    </label>
    <label class="field">Theme
      <select id="set-theme">
        <option value="auto">System</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
    </label>
    <label class="field">Sounds
      <input type="checkbox" id="set-sounds" />
    </label>
    <div class="mt-4 flex justify-end">
      <button class="btn btn-primary" type="button" data-close-dialog>Done</button>
    </div>
  </dialog>

  <script>
    import { startEuchre } from '../games/euchre/controller';
    startEuchre();
  </script>
</Layout>
