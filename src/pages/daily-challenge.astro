---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import GameNav from '../components/GameNav.astro';

const title = 'Daily Challenge — A New Game Every Day | CardHearth';
const description =
  'The CardHearth Daily Challenge rotates across every game — Solitaire, Sudoku, Mahjong, Minesweeper, 2048 and more. One puzzle a day, identical for everyone. Build a streak, free, no sign-up.';

const faq = [
  {
    q: 'How does the Daily Challenge work?',
    a: 'Every day a different game from the catalogue is the daily challenge, and its puzzle is identical for every player worldwide — both the game and its deal are derived from the date. Solve it before midnight UTC to extend your daily streak.',
  },
  {
    q: 'Which games are in the rotation?',
    a: 'All of them — Klondike (Draw 1 and Draw 3), Spider, FreeCell, Pyramid, TriPeaks, Golf, Sudoku, Mahjong, Minesweeper, and 2048 — cycling so every game comes around. The same game and puzzle appear for everyone on a given day.',
  },
  {
    q: 'Is the daily the same for everyone?',
    a: 'Yes. The game and its shuffle are generated from the calendar date, so your challenge is identical to everyone else’s. That makes times directly comparable — share yours and see who finishes faster.',
  },
  {
    q: 'What happens to my streak if I miss a day?',
    a: 'Your current streak resets when a day passes without a solve, but your best streak and your full history are kept. Your streak survives until midnight UTC, so there is always time to keep it alive today.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'CardHearth Daily Challenge',
    url: 'https://cardhearth.com/daily-challenge/',
    description,
    genre: 'Puzzle',
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    playMode: 'SinglePlayer',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: 'https://cardhearth.com/og.png',
    publisher: { '@type': 'Organization', name: 'CardHearth', url: 'https://cardhearth.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CardHearth', item: 'https://cardhearth.com/' },
      { '@type': 'ListItem', position: 2, name: 'Daily Challenge', item: 'https://cardhearth.com/daily-challenge/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <div class="mx-auto flex min-h-dvh w-full max-w-4xl flex-col px-4">
    <header class="flex flex-wrap items-center justify-between gap-2 py-3">
      <h1 class="text-xl font-extrabold tracking-tight sm:text-2xl">
        Daily Challenge
        <a href="/" class="font-normal no-underline opacity-70 hover:underline">· CardHearth</a>
      </h1>
      <a href="/" class="btn" aria-label="Back to the game menu">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>
        <span class="btn-label">Home</span>
      </a>
    </header>

    <GameNav current="daily" />

    <!-- Today's challenge — filled in client-side from the date. -->
    <section class="daily-hero">
      <p class="daily-hero-eyebrow" id="daily-hero-date">Today's challenge</p>
      <p class="daily-hero-game" id="daily-hero-game">Loading…</p>
      <p class="daily-hero-status" id="daily-hero-status"></p>
      <a id="daily-play" class="btn btn-primary daily-play-btn" href="/">Play today's challenge →</a>
      <dl class="daily-hero-stats" id="daily-hero-stats"></dl>
      <div class="daily-reminder" id="daily-reminder" hidden>
        <label class="daily-reminder-row">
          <input type="checkbox" id="reminder-toggle" />
          <span>🔔 Remind me to play each day</span>
        </label>
        <label class="daily-reminder-time" id="reminder-time-row" hidden>
          <span>Reminder time</span>
          <select id="reminder-hour"></select>
        </label>
        <p class="daily-reminder-note" id="reminder-note" role="status"></p>
      </div>
    </section>

    <section class="daily-calendar" aria-label="Daily Challenge calendar">
      <div class="cal-head">
        <button id="cal-prev" class="btn" type="button" aria-label="Previous year">‹</button>
        <h2 id="cal-year" class="cal-year">Calendar</h2>
        <button id="cal-next" class="btn" type="button" aria-label="Next year">›</button>
      </div>
      <p class="cal-intro">
        Missed a day? Play any past Daily Challenge to fill in your calendar. Complete every day of
        a calendar year to earn the <strong>Perfect Year</strong> badge. Future days stay locked
        until their date.
      </p>
      <p id="cal-progress" class="cal-progress"></p>
      <div id="cal-grid" class="cal-months"></div>
      <ul class="cal-legend">
        <li><span class="cal-key cal-key-solved"></span> Solved</li>
        <li><span class="cal-key cal-key-open"></span> Playable</li>
        <li><span class="cal-key cal-key-today"></span> Today</li>
        <li><span class="cal-key cal-key-locked"></span> Locked</li>
      </ul>
    </section>

    <section class="mx-auto max-w-2xl py-10 text-sm leading-relaxed opacity-90">
      <h2 class="mb-2 text-lg font-bold">One game. Everyone. Every day.</h2>
      <p class="mb-3">
        The Daily Challenge rotates across the whole CardHearth catalogue — one day it's
        Klondike, the next Sudoku, then Mahjong, Minesweeper, 2048 and on through every game.
        Whatever the day's game is, <strong>everyone in the world gets the identical puzzle</strong>,
        generated from the date itself. Finish it before midnight UTC to grow your
        <strong>daily streak</strong>, then share your time and dare a friend to beat it.
      </p>
      <h2 class="mb-2 text-lg font-bold">How streaks work</h2>
      <p class="mb-3">
        Solve the daily on consecutive days and your streak grows; miss a day and it resets
        (your best streak and full history are always kept — check the Stats panel inside any
        game). The streak survives until midnight UTC, so there's always time to keep it alive.
      </p>
      <h2 class="mb-2 text-lg font-bold">Frequently asked questions</h2>
      {
        faq.map((f) => (
          <details class="faq mb-2">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 opacity-90">{f.a}</p>
          </details>
        ))
      }
      <p class="mt-6 opacity-75">
        Prefer to choose? Browse <a class="underline" href="/">all games</a> on the menu.
      </p>
    </section>

    <Footer />
  </div>

  <script>
    import {
      dailyGame,
      dailyNumber,
      formatCountdown,
      msUntilNextDaily,
      loadDaily,
      currentDailyStreak,
      bestDailyStreak,
      totalDailySolves,
      isDailySolved,
      utcDateKey,
    } from '../lib/daily';
    import { formatTime } from '../lib/stats';
    import { track } from '../lib/analytics';

    const entry = dailyGame();
    track('daily_viewed', { game: entry.game });
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', {
      timeZone: 'UTC',
      weekday: 'long',
      month: 'long',
      day: 'numeric',
    });
    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };
    set('daily-hero-date', `Daily #${dailyNumber()} · ${dateStr}`);
    set('daily-hero-game', entry.label);

    const play = document.getElementById('daily-play') as HTMLAnchorElement | null;
    if (play) play.href = `${entry.path}?daily=1`;

    // The solved/streak parts depend on saved progress, which can arrive a beat
    // later from cloud sync — so re-run them on the synced event too.
    function renderHero() {
      const record = loadDaily();
      const solved = isDailySolved();
      const today = record.days[utcDateKey()];
      set(
        'daily-hero-status',
        solved && today
          ? `Solved in ${formatTime(today.timeMs)} ✓ — next game in ${formatCountdown(msUntilNextDaily())}`
          : `The same for everyone — next game in ${formatCountdown(msUntilNextDaily())}`,
      );
      if (play) play.textContent = solved ? 'Play again →' : "Play today's challenge →";
      const stats = document.getElementById('daily-hero-stats');
      if (stats) {
        stats.innerHTML = [
          `<dt>Current streak</dt><dd>${currentDailyStreak(record)} 🔥</dd>`,
          `<dt>Best streak</dt><dd>${bestDailyStreak(record)}</dd>`,
          `<dt>Days solved</dt><dd>${totalDailySolves(record)}</dd>`,
        ].join('');
      }
    }
    renderHero();
    window.addEventListener('cardhearth:synced', renderHero);
  </script>

  <script>
    import {
      dailyGame,
      dailyYearProgress,
      loadDaily,
      utcDateKey,
      DAILY_EPOCH_UTC,
    } from '../lib/daily';

    const gridEl = document.getElementById('cal-grid');
    const yearEl = document.getElementById('cal-year');
    const progressEl = document.getElementById('cal-progress');
    const prevBtn = document.getElementById('cal-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('cal-next') as HTMLButtonElement | null;

    if (gridEl && yearEl && progressEl && prevBtn && nextBtn) {
      const DAY_MS = 86_400_000;
      const calRecord = loadDaily();
      const now = new Date();
      const todayKey = utcDateKey(now);
      const todayUTC = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
      const epochYear = new Date(DAILY_EPOCH_UTC).getUTCFullYear();
      const currentYear = now.getUTCFullYear();
      let viewYear = currentYear;

      const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
      const WD = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];

      function monthHtml(year: number, month: number): string {
        const first = new Date(Date.UTC(year, month, 1));
        const firstWeekday = first.getUTCDay();
        const days = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
        const name = first.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long' });
        let cells = '';
        for (let i = 0; i < firstWeekday; i++) cells += '<span class="cal-day cal-blank"></span>';
        for (let d = 1; d <= days; d++) {
          const dayUTC = Date.UTC(year, month, d);
          const key = utcDateKey(new Date(dayUTC));
          if (dayUTC < DAILY_EPOCH_UTC) {
            cells += `<span class="cal-day cal-pre" aria-hidden="true">${d}</span>`;
          } else if (key > todayKey) {
            cells += `<span class="cal-day cal-future" title="Unlocks ${key}" aria-label="${name} ${d}: locked">${d}</span>`;
          } else {
            const entry = dailyGame(new Date(dayUTC));
            const solved = !!calRecord.days[key];
            const cls =
              'cal-day cal-open' +
              (solved ? ' cal-solved' : '') +
              (key === todayKey ? ' cal-today' : '');
            const label = `${entry.label}${solved ? ' — solved ✓' : ''}`;
            cells += `<a class="${cls}" href="${entry.path}?daily=${key}" title="${esc(label)}" aria-label="${name} ${d}: ${esc(label)}">${d}</a>`;
          }
        }
        const head = WD.map((w) => `<span class="cal-wd">${w}</span>`).join('');
        return `<div class="cal-month"><h3 class="cal-month-name">${name}</h3><div class="cal-grid">${head}${cells}</div></div>`;
      }

      function render() {
        yearEl!.textContent = String(viewYear);
        const p = dailyYearProgress(calRecord, viewYear, now);
        const fullyElapsed = Date.UTC(viewYear, 11, 31) < todayUTC;
        progressEl!.textContent =
          p.available === 0
            ? 'No Daily Challenges in this year yet.'
            : `${p.solved} of ${p.available} solved` +
              (fullyElapsed && p.available > 0 && p.solved === p.available
                ? ' · Perfect Year! 🏵️'
                : '');
        let html = '';
        for (let m = 0; m < 12; m++) html += monthHtml(viewYear, m);
        gridEl!.innerHTML = html;
        prevBtn!.disabled = viewYear <= epochYear;
        nextBtn!.disabled = viewYear >= currentYear;
      }

      prevBtn.addEventListener('click', () => {
        if (viewYear > epochYear) {
          viewYear--;
          render();
        }
      });
      nextBtn.addEventListener('click', () => {
        if (viewYear < currentYear) {
          viewYear++;
          render();
        }
      });
      render();
      window.addEventListener('cardhearth:synced', render);
    }
  </script>

  <script>
    import { reminderState, enableReminder, disableReminder, updateReminderHour, lastPushError } from '../lib/push';

    const wrap = document.getElementById('daily-reminder');
    const state = reminderState();
    if (wrap && state.configured && state.supported) {
      wrap.hidden = false;
      const toggle = document.getElementById('reminder-toggle') as HTMLInputElement;
      const timeRow = document.getElementById('reminder-time-row') as HTMLElement;
      const hourSel = document.getElementById('reminder-hour') as HTMLSelectElement;
      const note = document.getElementById('reminder-note') as HTMLElement;

      const fmtHour = (h: number) => {
        const ampm = h < 12 ? 'AM' : 'PM';
        const hr = h % 12 === 0 ? 12 : h % 12;
        return `${hr}:00 ${ampm}`;
      };
      for (let h = 0; h < 24; h++) {
        const o = document.createElement('option');
        o.value = String(h);
        o.textContent = fmtHour(h);
        hourSel.appendChild(o);
      }
      hourSel.value = String(state.pref.hour);
      const on = state.pref.enabled && state.permission === 'granted';
      toggle.checked = on;
      timeRow.hidden = !on;
      if (state.permission === 'denied') {
        note.textContent =
          'Notifications are blocked — enable them in your browser settings to use reminders.';
      }

      toggle.addEventListener('change', async () => {
        if (toggle.checked) {
          note.textContent = 'Enabling…';
          const res = await enableReminder(Number(hourSel.value));
          if (res === 'ok') {
            timeRow.hidden = false;
            note.textContent = `Reminder set for ${fmtHour(Number(hourSel.value))} — we'll only nudge you if you haven't played.`;
          } else {
            toggle.checked = false;
            timeRow.hidden = true;
            note.textContent =
              res === 'denied'
                ? 'Notifications are blocked — enable them in your browser settings.'
                : `Couldn't enable reminders — ${lastPushError() || 'please try again'}.`;
          }
        } else {
          await disableReminder();
          timeRow.hidden = true;
          note.textContent = 'Daily reminder turned off.';
        }
      });

      hourSel.addEventListener('change', async () => {
        await updateReminderHour(Number(hourSel.value));
        if (toggle.checked) note.textContent = `Reminder set for ${fmtHour(Number(hourSel.value))}.`;
      });
    }
  </script>
</Layout>
