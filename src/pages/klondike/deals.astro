---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const title = 'Klondike Deal Numbers — Replay or Share Any Deal | CardHearth';
const description =
  'Every Klondike deal on CardHearth has a number you can replay or share — type a deal number to play those exact cards, in Draw 1 or Draw 3. Reproducible and shareable.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Klondike Deal Numbers',
    description,
    url: 'https://cardhearth.com/klondike/deals/',
    isPartOf: { '@type': 'WebSite', name: 'CardHearth', url: 'https://cardhearth.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CardHearth', item: 'https://cardhearth.com/' },
      { '@type': 'ListItem', position: 2, name: 'Klondike', item: 'https://cardhearth.com/klondike/' },
      { '@type': 'ListItem', position: 3, name: 'Deal numbers', item: 'https://cardhearth.com/klondike/deals/' },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="mx-auto flex min-h-dvh w-full max-w-2xl flex-col px-4">
    <nav class="breadcrumb pt-6" aria-label="Breadcrumb">
      <a href="/">CardHearth</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <a href="/klondike/">Klondike</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span aria-current="page">Deal numbers</span>
    </nav>

    <header class="pt-4 pb-2">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Klondike deal numbers</h1>
      <p class="mt-3 text-lg opacity-80">
        Every Klondike deal here has a number — you'll see it as <strong>#12345</strong> while you
        play. Type any number below to deal those <strong>exact cards</strong> again, so you can retry
        a deal, share one with a friend, or compare a different line of play on the same game.
      </p>
    </header>

    <article class="prose py-4">
      <h2>Play a deal by number</h2>
      <p>Choose Draw 1 or Draw 3, enter a deal number, and we'll deal that exact game.</p>
      <form id="deal-jump" class="deal-jump" role="search" aria-label="Play a Klondike deal by number">
        <label for="deal-n" class="visually-hidden">Klondike deal number</label>
        <input id="deal-n" name="n" type="number" inputmode="numeric" min="1" max="1000000" placeholder="e.g. 4821" required />
        <label for="deal-mode" class="visually-hidden">Draw mode</label>
        <select id="deal-mode" name="mode">
          <option value="1">Draw 1</option>
          <option value="3">Draw 3</option>
        </select>
        <button class="btn btn-primary" type="submit">▶ Play this deal</button>
      </form>

      <h2>How deal numbers work</h2>
      <p>
        The deal number is the seed for the shuffle, so the same number always produces the same cards
        — it's fully reproducible. To share the deal you're on, use the <strong>Share deal</strong>
        button in any game; to replay a number someone sent you, just type it in above. (These are
        CardHearth's own deal numbers, not the Windows numbering — that standard only applies to
        <a href="/freecell/deals/">FreeCell</a>.)
      </p>

      <h2>Are all Klondike deals winnable?</h2>
      <p>
        No — and that's the honest difference from FreeCell. Klondike deals aren't screened for
        solvability: with perfect play roughly <strong>80% of Draw 1 deals</strong> are winnable, and
        some are genuinely impossible no matter how you play. Draw 3 is harder still. If a number beats
        you, replay it to test a new line, or read <a href="/guides/how-to-win-klondike-solitaire/">how
        to win Klondike</a> and <a href="/guides/are-solitaire-games-winnable/">are solitaire games
        winnable?</a> for the full picture.
      </p>
    </article>

    <p class="py-6">
      <a class="guide-cta" href="/klondike/">▶ Play Klondike (random deal)</a>
    </p>

    <Footer />
  </main>
</Layout>

<script>
  const form = document.getElementById('deal-jump') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('deal-n') as HTMLInputElement | null;
    const mode = (document.getElementById('deal-mode') as HTMLSelectElement | null)?.value ?? '1';
    const n = Math.floor(Number(input?.value));
    if (!Number.isFinite(n) || n < 1 || n > 1_000_000) {
      input?.focus();
      return;
    }
    window.location.href = `/klondike/?deal=${n}&mode=${mode}`;
  });
</script>
