---
import Layout from '../layouts/Layout.astro';
import GameShell from '../components/GameShell.astro';

const title = 'Solitude — Play Klondike Solitaire Free Online';
const description =
  'Play classic Klondike Solitaire free in your browser. Draw 1 or Draw 3, unlimited undo, hints, auto-finish, and smooth animations on desktop and mobile. No download, no sign-up.';
---

<Layout title={title} description={description}>
  <GameShell
    gameId="klondike"
    heading="Klondike Solitaire"
    variantLabel="Draw mode"
    variantOptions={[
      { value: 1, label: 'Draw 1' },
      { value: 3, label: 'Draw 3' },
    ]}
  >
    <h2 class="mb-2 text-lg font-bold">How to play Klondike Solitaire</h2>
    <p class="mb-3">
      Build the four foundations from Ace to King, one per suit. On the tableau, stack cards in
      descending order with alternating colors — drag cards or simply tap one to send it to the
      best spot. Only Kings may be placed on empty columns. Draw from the stock when you're out
      of moves, and recycle the waste pile when the stock runs dry.
    </p>
    <h2 class="mb-2 text-lg font-bold">Tips &amp; shortcuts</h2>
    <p class="mb-3">
      Flip face-down tableau cards as early as you can, and don't rush cards to the foundations —
      you may still need them to build runs. Stuck? Use <strong>Hint</strong> (H). Made a mistake?
      <strong>Undo</strong> is unlimited (Ctrl+Z). Press <strong>D</strong> or tap the stock to
      draw, and <strong>N</strong> for a new deal. Switch between Draw&nbsp;1 and Draw&nbsp;3 in
      Settings. When every card is face up, <strong>Auto-finish</strong> completes the game for you.
    </p>
    <p class="opacity-75">
      Solitude is free, runs entirely in your browser, and saves your games, settings and
      statistics on your device. No account needed. Also try
      <a class="underline" href="/spider">Spider</a> and
      <a class="underline" href="/freecell">FreeCell</a>.
    </p>
  </GameShell>

  <script>
    import { startGame } from '../games/cards/controller';
    import { klondikeRules } from '../games/cards/klondike';
    startGame(klondikeRules);
  </script>
</Layout>
