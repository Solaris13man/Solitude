---
import Layout from '../layouts/Layout.astro';
import GameArt from '../components/GameArt.astro';
import Footer from '../components/Footer.astro';
import { GAMES } from '../games/registry';

const cardCount = GAMES.filter((g) => g.category === 'cards').length;
const puzzleCount = GAMES.filter((g) => g.category === 'puzzle').length;
const gameCount = cardCount + puzzleCount;

const title = 'CardHearth — Free Solitaire, Card & Puzzle Games Online';
const description =
  `Play ${gameCount} free solitaire, card and puzzle games in your browser — no download, no sign-up. Hearts, Spades, Gin Rummy and Euchre against the computer, plus Klondike, FreeCell, Sudoku, Mahjong and more.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'CardHearth',
    url: 'https://cardhearth.com/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'CardHearth',
    url: 'https://cardhearth.com/',
    logo: 'https://cardhearth.com/logo.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'CardHearth free online games',
    url: 'https://cardhearth.com/',
    description,
    hasPart: GAMES.map((g) => ({
      '@type': 'VideoGame',
      name: g.name,
      url: `https://cardhearth.com${g.href}`,
    })),
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="mx-auto flex min-h-dvh w-full max-w-4xl flex-col px-4">
    <div class="flex justify-end pt-3">
      <a href="/account/" class="btn" id="account-link">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        <span id="account-link-label">Account &amp; badges</span>
      </a>
    </div>
    <header class="pt-6 pb-10 text-center sm:pb-12">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
        Free Solitaire &amp; Puzzle Games
      </h1>
      <p class="mx-auto mt-3 max-w-lg text-base opacity-85">
        Your cozy home for {cardCount + puzzleCount} classic card &amp; puzzle games. Pick one and play
        in seconds — nothing to install, no account needed.
      </p>
      <ul class="feature-pills" aria-label="What's included">
        <li>🎴 {cardCount + puzzleCount} free games</li>
        <li>📅 Daily Challenge</li>
        <li>🚫 No sign-up</li>
        <li>🏆 Stats &amp; achievements</li>
        <li>📲 Installable app</li>
      </ul>
      <ul class="trust-strip" aria-label="Why CardHearth">
        <li><strong>No guessing</strong>Every Sudoku is solvable by pure logic — guaranteed.</li>
        <li><strong>Always solvable</strong>Every Mahjong board is winnable by design.</li>
        <li><strong>Free &amp; private</strong>No sign-up, no download. Progress stays on your device.</li>
      </ul>
      <p class="mt-5 text-sm">
        <a class="underline opacity-80 hover:opacity-100" href="/about/">Why CardHearth? Read the story →</a>
      </p>
    </header>

    <nav aria-label="Choose a game">
      <a href="/daily-challenge/" class="daily-feature">
        <span class="daily-feature-art" aria-hidden="true"><GameArt game="daily" /></span>
        <span class="daily-feature-body">
          <span class="daily-feature-eyebrow">⭐ Daily Challenge</span>
          <span class="daily-feature-title">A new game every day</span>
          <span class="daily-feature-tag">
            One puzzle, the same for everyone — build your streak and fill your calendar.
          </span>
          <span class="daily-feature-play">Play today's challenge →</span>
        </span>
      </a>

      {
        [
          { key: 'cards', title: 'Card Games' },
          { key: 'puzzle', title: 'Puzzles' },
        ].map((section) => (
          <>
            <h2 class="menu-section">{section.title}</h2>
            <div class="menu-grid">
              {GAMES.filter((g) => g.category === section.key && g.id !== 'daily').map((game) => (
                <a href={game.href} class="menu-card">
                  <span class="menu-art" aria-hidden="true">
                    <GameArt game={game.id} />
                  </span>
                  <span class="menu-card-body">
                    <span class="menu-card-name">{game.name}</span>
                    <span class="menu-card-tag">{game.tagline}</span>
                    {game.highlight && <span class="menu-card-highlight">✓ {game.highlight}</span>}
                    <span class="menu-card-play">Play now →</span>
                  </span>
                </a>
              ))}
            </div>
            {
              GAMES.filter((g) => g.category === section.key && g.variants?.length).length > 0 && (
                <ul class="menu-variants">
                  {GAMES.filter((g) => g.category === section.key && g.variants?.length).map((g) => (
                    <li>
                      <span class="menu-variants-game">{g.name}:</span>
                      {g.variants!.map((v) => (
                        <a href={v.href}>{v.label}</a>
                      ))}
                    </li>
                  ))}
                </ul>
              )
            }
          </>
        ))
      }
    </nav>

    <section class="why-play" aria-label="Why play on CardHearth">
      <h2 class="why-play-title">Why play on CardHearth?</h2>
      <ul class="why-grid">
        <li>
          <span class="why-icon" aria-hidden="true">✅</span>
          <strong>Fair puzzles</strong>
          Every Sudoku is logic-solvable and every Mahjong board is guaranteed clearable.
        </li>
        <li>
          <span class="why-icon" aria-hidden="true">↩️</span>
          <strong>Unlimited undo &amp; hints</strong>
          Explore a line, take it back, and get a nudge whenever you're stuck.
        </li>
        <li>
          <span class="why-icon" aria-hidden="true">📅</span>
          <strong>Daily Challenge</strong>
          A new game each day, the same for everyone, with a streak to defend.
        </li>
        <li>
          <span class="why-icon" aria-hidden="true">📈</span>
          <strong>Track your progress</strong>
          Per-game stats, win streaks, and 20 achievements to unlock.
        </li>
        <li>
          <span class="why-icon" aria-hidden="true">📲</span>
          <strong>Play anywhere</strong>
          Mouse, touch or keyboard — and install it as an app on any device.
        </li>
        <li>
          <span class="why-icon" aria-hidden="true">🔒</span>
          <strong>Free &amp; private</strong>
          No sign-up, no download; your progress stays on your device.
        </li>
      </ul>
      <p class="why-cta">
        <a class="guide-cta" href="/daily-challenge/">▶ Start with today's Daily Challenge</a>
      </p>
    </section>

    <section class="mx-auto max-w-2xl py-12 text-sm leading-relaxed opacity-90">
      <h2 class="mb-2 text-lg font-bold">Solitaire, puzzles, and classics — all free</h2>
      <p class="mb-3">
        The card table runs deep: <a class="underline" href="/klondike/">Klondike</a> (Draw 1 or
        Draw 3), <a class="underline" href="/spider/">Spider</a> in 1, 2 or 4 suits,
        <a class="underline" href="/freecell/">FreeCell</a>, plus
        <a class="underline" href="/pyramid/">Pyramid</a>,
        <a class="underline" href="/tripeaks/">TriPeaks</a> and
        <a class="underline" href="/golf/">Golf</a>. On the puzzle side there's
        <a class="underline" href="/sudoku/">Sudoku</a> (four difficulties, every puzzle solvable
        by logic), <a class="underline" href="/mahjong/">Mahjong</a> with eight layouts and a
        guaranteed-winnable promise, classic <a class="underline" href="/minesweeper/">Minesweeper</a>,
        and <a class="underline" href="/2048/">2048</a>.
      </p>
      <p class="mb-3">
        Every game works with mouse, touch or keyboard, with unlimited undo, hints, and numbered
        deals you can replay or share to challenge a friend on the exact same board. And once a
        day there's the <a class="underline" href="/daily-challenge/">Daily Challenge</a> — one
        deal, identical for everyone, with a streak to defend.
      </p>
      <p class="mb-3">
        New to a game or want to win more? Our <a class="underline" href="/guides/">strategy
        guides and rules</a> cover every game — from <a class="underline" href="/guides/solitaire-rules/">how
        to play Solitaire</a> to <a class="underline" href="/guides/sudoku-solving-techniques/">advanced
        Sudoku techniques</a>.
      </p>
      <p class="opacity-75">
        CardHearth runs right in your browser — no install, no account required, always free to
        play. Sign in only if you want to <a class="underline" href="/account/">sync your
        progress and badges</a> across devices.
      </p>
    </section>

    <section class="popular-guides" aria-label="Popular guides">
      <h2 class="why-play-title">Popular guides</h2>
      <ul class="popular-guides-list">
        <li><a href="/guides/solitaire-rules/">How to Play Solitaire (Klondike rules)</a></li>
        <li><a href="/guides/how-to-win-klondike-solitaire/">How to Win Klondike Solitaire</a></li>
        <li><a href="/guides/spider-solitaire-strategy/">Spider Solitaire Strategy</a></li>
        <li><a href="/guides/sudoku-solving-techniques/">Sudoku Solving Techniques</a></li>
        <li><a href="/guides/freecell-rules/">FreeCell Rules</a></li>
        <li><a href="/guides/">Browse all guides &amp; rules →</a></li>
      </ul>
    </section>

    <Footer />
  </main>

  <script>
    import { getCachedUser } from '../lib/account';
    const user = getCachedUser();
    if (user) {
      const label = document.getElementById('account-link-label');
      if (label) label.textContent = user.name.split(' ')[0] || 'Account';
    }
  </script>
</Layout>
