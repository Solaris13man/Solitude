---
import Layout from '../layouts/Layout.astro';
import GameArt from '../components/GameArt.astro';
import { GAMES } from '../games/registry';

const title = 'Solitude — Free Classic Card Games Online';
const description =
  'Play Klondike Solitaire, Spider, and FreeCell free in your browser. Smooth animations, full touch support, unlimited undo — no download, no ads in your face, no sign-up.';
---

<Layout title={title} description={description}>
  <main class="mx-auto flex min-h-dvh w-full max-w-4xl flex-col px-4">
    <header class="py-10 text-center sm:py-14">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Solitude</h1>
      <p class="mx-auto mt-3 max-w-md text-base opacity-85">
        Free classic card games, beautifully playable on any device. Pick a game to start —
        your progress, stats and streaks are saved automatically.
      </p>
    </header>

    <nav class="menu-grid" aria-label="Choose a game">
      {
        GAMES.map((game) => (
          <a href={game.href} class="menu-card">
            <span class="menu-art" aria-hidden="true">
              <GameArt game={game.id} />
            </span>
            <span class="menu-card-body">
              <span class="menu-card-name">{game.name}</span>
              <span class="menu-card-tag">{game.tagline}</span>
              <span class="menu-card-play">Play now →</span>
            </span>
          </a>
        ))
      }
    </nav>

    <section class="mx-auto max-w-2xl py-12 text-sm leading-relaxed opacity-90">
      <h2 class="mb-2 text-lg font-bold">Three classics, one place</h2>
      <p class="mb-3">
        <a class="underline" href="/klondike">Klondike</a> is the solitaire everyone knows —
        build four foundations from Ace to King, in Draw&nbsp;1 or Draw&nbsp;3 mode.
        <a class="underline" href="/spider">Spider</a> deals two full decks across ten columns;
        assemble complete King-to-Ace runs in 1, 2 or 4-suit difficulty.
        <a class="underline" href="/freecell">FreeCell</a> lays every card face up — with four
        spare cells and a clear head, nearly every deal can be won.
      </p>
      <p class="opacity-75">
        Every game works with mouse, touch or keyboard, supports unlimited undo and hints, and
        runs entirely on your device — no account, no install. More classic games are on the way.
      </p>
    </section>
  </main>
</Layout>
